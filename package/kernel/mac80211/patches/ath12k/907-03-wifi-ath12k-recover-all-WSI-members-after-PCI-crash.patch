--- a/drivers/net/wireless/ath/ath12k/core.c
+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -1768,12 +1768,69 @@
 	complete(&ab->restart_completed);
 }
 
+void ath12k_core_queue_group_recovery(struct ath12k_base *ab)
+{
+	struct ath12k_hw_group *ag = ab->ag;
+	struct ath12k_base *partner_ab;
+	int i;
+
+	if (!ag)
+		return;
+
+	/* Called from a reset worker, threaded IRQ or blocking SSR notifier,
+	 * never directly from the MHI status callback. Protect member lifetime
+	 * and serialize queueing with the remove paths.
+	 */
+	mutex_lock(&ag->mutex);
+	if (!test_bit(ATH12K_GROUP_FLAG_REGISTERED, &ag->flags) ||
+	    test_bit(ATH12K_GROUP_FLAG_UNREGISTER, &ag->flags) ||
+	    test_bit(ATH12K_GROUP_FLAG_SHUTDOWN, &ag->flags) ||
+	    test_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags))
+		goto unlock;
+
+	for (i = 0; i < ag->num_devices; i++) {
+		partner_ab = ag->ab[i];
+		if (!partner_ab ||
+		    !test_bit(ATH12K_FLAG_REGISTERED, &partner_ab->dev_flags) ||
+		    !test_bit(ATH12K_FLAG_QMI_FW_READY_COMPLETE, &partner_ab->dev_flags) ||
+		    test_bit(ATH12K_FLAG_UNREGISTERING, &partner_ab->dev_flags))
+			continue;
+
+		set_bit(ATH12K_FLAG_CRASH_FLUSH, &partner_ab->dev_flags);
+		set_bit(ATH12K_FLAG_RECOVERY, &partner_ab->dev_flags);
+
+		if (READ_ONCE(partner_ab->is_reset) ||
+		    work_busy(&partner_ab->reset_work))
+			continue;
+
+		if (queue_work(partner_ab->workqueue_aux, &partner_ab->reset_work))
+			ath12k_info(partner_ab, "group %d recovery queued by device %d\n",
+				    ag->id, ab->device_id);
+	}
+
+unlock:
+	mutex_unlock(&ag->mutex);
+}
+EXPORT_SYMBOL(ath12k_core_queue_group_recovery);
+
 static void ath12k_core_reset(struct work_struct *work)
 {
 	struct ath12k_base *ab = container_of(work, struct ath12k_base, reset_work);
 	struct ath12k_hw_group *ag = ab->ag;
-	int reset_count, fail_cont_count, i;
+	int reset_count, fail_cont_count, i, ret;
 	long time_left;
+
+	if (!ag)
+		return;
+
+	mutex_lock(&ag->mutex);
+	if (test_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags) ||
+	    test_bit(ATH12K_GROUP_FLAG_UNREGISTER, &ag->flags) ||
+	    test_bit(ATH12K_GROUP_FLAG_SHUTDOWN, &ag->flags)) {
+		mutex_unlock(&ag->mutex);
+		return;
+	}
+	mutex_unlock(&ag->mutex);
 
 	if (!(test_bit(ATH12K_FLAG_QMI_FW_READY_COMPLETE, &ab->dev_flags))) {
 		ath12k_warn(ab, "firmware crashed before QMI ready; recovery skipped (dev flags 0x%lx)\n",
@@ -1819,8 +1876,16 @@
 
 	ath12k_dbg(ab, ATH12K_DBG_BOOT, "reset starting\n");
 
-	ab->is_reset = true;
+	WRITE_ONCE(ab->is_reset, true);
 	atomic_set(&ab->recovery_count, 0);
+
+	/* Reconfiguration halts every wiphy in the WSI group even when MLO
+	 * is disabled. All live members must enter reset before the shared
+	 * memory can be reused; a PCI RDDM event only queues this device.
+	 */
+	ath12k_core_queue_group_recovery(ab);
+	ath12k_info(ab, "group %d recovery: resetting device %d\n",
+		    ag->id, ab->device_id);
 
 	ath12k_coredump_collect(ab);
 	ath12k_core_pre_reconfigure_recovery(ab);
@@ -1841,13 +1906,29 @@
 	mutex_lock(&ag->mutex);
 	ath12k_core_to_group_ref_put(ab);
 
+	if (test_bit(ATH12K_GROUP_FLAG_UNREGISTER, &ag->flags) ||
+	    test_bit(ATH12K_GROUP_FLAG_SHUTDOWN, &ag->flags)) {
+		mutex_unlock(&ag->mutex);
+		return;
+	}
+
 	if (ag->num_started > 0) {
-		ath12k_dbg(ab, ATH12K_DBG_BOOT,
-			   "waiting for %d partner device(s) to reset\n",
-			   ag->num_started);
+		ath12k_info(ab, "group %d recovery: waiting for %d partner device(s)\n",
+			    ag->id, ag->num_started);
 		mutex_unlock(&ag->mutex);
 		return;
 	}
+
+	for (i = 0; i < ag->num_devices; i++) {
+		if (ag->ab[i] &&
+		    test_bit(ATH12K_FLAG_UNREGISTERING, &ag->ab[i]->dev_flags)) {
+			mutex_unlock(&ag->mutex);
+			return;
+		}
+	}
+
+	ath12k_info(ab, "group %d recovery: all devices stopped, restarting\n",
+		    ag->id);
 
 	/* Prepare MLO global memory region for power up */
 	ath12k_qmi_reset_mlo_mem(ag);
@@ -1857,7 +1938,10 @@
 		if (!ab)
 			continue;
 
-		ath12k_hif_power_up(ab);
+		ret = ath12k_hif_power_up(ab);
+		if (ret)
+			ath12k_warn(ab, "group %d recovery: device %d power up failed: %d\n",
+				    ag->id, ab->device_id, ret);
 		ath12k_dbg(ab, ATH12K_DBG_BOOT, "reset started\n");
 	}
 
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -1323,6 +1323,7 @@
 int ath12k_core_check_dt(struct ath12k_base *ath12k);
 int ath12k_core_check_smbios(struct ath12k_base *ab);
 void ath12k_core_halt(struct ath12k *ar);
+void ath12k_core_queue_group_recovery(struct ath12k_base *ab);
 int ath12k_core_resume_early(struct ath12k_base *ab);
 int ath12k_core_resume(struct ath12k_base *ab);
 int ath12k_core_suspend(struct ath12k_base *ab);
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -1720,7 +1720,10 @@
 		goto qmi_fail;
 	}
 
+	/* A group recovery may queue our reset work from another device. */
+	mutex_lock(&ab->ag->mutex);
 	set_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags);
+	mutex_unlock(&ab->ag->mutex);
 
 	cancel_work_sync(&ab->reset_work);
 	cancel_work_sync(&ab->dump_work);
