From: GWRT maintainers <gwrt@localhost>
Subject: [PATCH] wifi: ath12k: recover all WSI members after a PCI crash

A PCI RDDM event queues only its own reset worker. Reconfiguration stops
all group wiphys, but power-up waits until every member drops its started
reference. Queue the live partners from process context before group
reconfiguration, using the same coordinator as AHB UserPD and RootPD
recovery. Keep the shared-memory barrier and the MLO policy unchanged.

Skip stopping groups and unavailable members, drain AHB reset work before
unassignment, and serialize removal with cross-device work submission.
Report the queue, barrier and restart stages in normal kernel logs.
This repairs host recovery; it does not fix the firmware's initial assert.

---
--- a/drivers/net/wireless/ath/ath12k/ahb.c
+++ b/drivers/net/wireless/ath/ath12k/ahb.c
@@ -28,7 +28,6 @@
 				     "ready",
 				     "stop-ack",
 				     "fatal"};
-static void ath12k_ahb_queue_group_recovery(struct ath12k_base *ab);
 
 static const char *irq_name[ATH12K_IRQ_NUM_MAX] = {
 	"misc-pulse1",
@@ -862,7 +861,7 @@
 	ath12k_ahb_log_userpd_crash_reason(ab);
 	if (test_bit(ATH12K_FLAG_REGISTERED, &ab->dev_flags) &&
 	    !test_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags))
-		ath12k_ahb_queue_group_recovery(ab);
+		ath12k_core_queue_group_recovery(ab);
 }
 
 static irqreturn_t ath12k_userpd_irq_handler(int irq, void *data)
@@ -953,35 +952,6 @@
 			    ab_ahb->userpd_id, ret);
 }
 
-static void ath12k_ahb_queue_group_recovery(struct ath12k_base *ab)
-{
-	struct ath12k_hw_group *ag = ab->ag;
-	struct ath12k_base *partner_ab;
-	int i;
-
-	if (!ag)
-		return;
-
-	mutex_lock(&ag->mutex);
-	for (i = 0; i < ag->num_devices; i++) {
-		partner_ab = ag->ab[i];
-		if (!partner_ab ||
-		    !test_bit(ATH12K_FLAG_REGISTERED, &partner_ab->dev_flags) ||
-		    test_bit(ATH12K_FLAG_UNREGISTERING, &partner_ab->dev_flags))
-			continue;
-
-		set_bit(ATH12K_FLAG_CRASH_FLUSH, &partner_ab->dev_flags);
-		set_bit(ATH12K_FLAG_RECOVERY, &partner_ab->dev_flags);
-
-		if (READ_ONCE(partner_ab->is_reset) ||
-		    work_busy(&partner_ab->reset_work))
-			continue;
-
-		queue_work(partner_ab->workqueue_aux, &partner_ab->reset_work);
-	}
-	mutex_unlock(&ag->mutex);
-}
-
 static int ath12k_ahb_root_pd_state_notifier(struct notifier_block *nb,
 					     const unsigned long event, void *data)
 {
@@ -994,7 +964,7 @@
 		ath12k_dbg(ab, ATH12K_DBG_AHB, "Root PD is UP\n");
 		complete(&ab_ahb->rootpd_ready);
 		if (READ_ONCE(ab_ahb->rootpd_crashed))
-			ath12k_ahb_queue_group_recovery(ab);
+			ath12k_core_queue_group_recovery(ab);
 		return NOTIFY_OK;
 	case QCOM_SSR_BEFORE_SHUTDOWN:
 		if (!notify_data || !notify_data->crashed)
@@ -1375,7 +1345,11 @@
 			ath12k_warn(ab, "failed to receive recovery response completion\n");
 	}
 
+	/* Serialize with group recovery before draining its queued work. */
+	mutex_lock(&ab->ag->mutex);
 	set_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags);
+	mutex_unlock(&ab->ag->mutex);
+	cancel_work_sync(&ab->reset_work);
 	cancel_work_sync(&ab->restart_work);
 	cancel_work_sync(&ab->qmi.event_work);
