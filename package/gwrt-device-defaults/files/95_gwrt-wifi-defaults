#!/bin/sh
# 新 radio 的默认 SSID 由 /etc/init.d/gwrt-wifi-ssid 在 phy 就绪后一次性写入
# （GWRT_<频段>_<radio MAC 后4>），不再靠 phy 热插拔反复改写。
# 这里只负责启用该服务；SS-01 额外保留延后首启链的就绪屏障。
# Never rewrite saved user/Mesh SSIDs, keys, channels, country or disabled state here.

[ -x /etc/init.d/gwrt-wifi-ssid ] && /etc/init.d/gwrt-wifi-ssid enable >/dev/null 2>&1

BOARD="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
[ "$BOARD" = 'jdcloud,re-ss-01' ] || exit 0

# S10boot sources uci-defaults in a subshell; $$ is the S10 shell PID.
if [ "${GWRT_SS01_FIRSTBOOT_WORKER:-0}" != 1 ]; then
	printf '%s\n' "$$" > /tmp/gwrt-ss01-uci-defaults.pid
	exit 1
fi

[ -f /etc/config/wireless ] || exit 1
has_2g=0
has_5g=0
for iface in $(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p'); do
	[ "$(uci -q get "wireless.$iface.mode")" = ap ] || continue
	case "$iface" in wifiroam_bh*) continue ;; esac
	[ -n "$(uci -q get "wireless.$iface.ssid")" ] || continue
	radio="$(uci -q get "wireless.$iface.device")"
	case "$(uci -q get "wireless.$radio.band")" in
		2g) has_2g=1 ;;
		5g) has_5g=1 ;;
	esac
done
[ "$has_2g" = 1 ] && [ "$has_5g" = 1 ]
