#!/bin/sh
# wifiroam（漫游组网）默认值 + 去掉“打赏”
#
# - 角色默认 unconfigured（普通 AP，等主AP 配对；可一键改主AP）
# - 无线回传 SSID/密码：mesh-gwrt / Abc123abc8888
# - 用我们打过补丁的 topology.js 覆盖安装包里的版本（去掉“用得爽，打个赏”）

SRC=/usr/share/gwrt/wifiroam
VIEW=/www/luci-static/resources/view/wifiroam

# 0) 打过补丁的守护进程：支持主AP 下发 SSID/密码（同一 ESS 才能无缝漫游）
if [ -f "$SRC/wifiroamd.uc" ] && [ -d /usr/share/wifiroam ]; then
	cmp -s "$SRC/wifiroamd.uc" /usr/share/wifiroam/wifiroamd.uc || \
		cp -f "$SRC/wifiroamd.uc" /usr/share/wifiroam/wifiroamd.uc
fi

# 1) 打赏按钮/弹窗 + 中文标题（补丁版页面）
if [ -d "$SRC" ]; then
	for f in topology.js clients.js pairing.js settings.js; do
		[ -f "$SRC/$f" ] && [ -d "$VIEW" ] || continue
		cmp -s "$SRC/$f" "$VIEW/$f" || cp -f "$SRC/$f" "$VIEW/$f"
	done
	# 菜单标题：无线漫游 / 网络拓扑 / 客户端 / 漫游设置 / Mesh 配对
	if [ -f "$SRC/menu.json" ] && [ -f /usr/share/luci/menu.d/luci-app-wifiroam.json ]; then
		cmp -s "$SRC/menu.json" /usr/share/luci/menu.d/luci-app-wifiroam.json || \
			cp -f "$SRC/menu.json" /usr/share/luci/menu.d/luci-app-wifiroam.json
	fi
	rm -f /tmp/luci-indexcache
fi

# 2) UCI 默认值
if [ -f /etc/config/wifiroam ]; then
	uci -q set wifiroam.core.enabled='1'
	# 默认「AP / 未配置」：上电就是普通 AP，插网线或靠近主AP 都能被
	# 主AP 发现并一键配对（配对后自动变成子AP）。
	# 要当主路由：无线漫游 → Mesh 配对 → 设为主AP，
	#   或 ubus call wifiroam set_role '{"role":"cap"}'
	uci -q set wifiroam.core.role='unconfigured'
	uci -q set wifiroam.backhaul.enabled='1'
	uci -q set wifiroam.backhaul.ssid='mesh-gwrt'
	uci -q set wifiroam.backhaul.key='Abc123abc8888'

	# 回传统一 3-addr（wds=0）：4-addr 在 JDCloud 主AP 上四步握手不稳
	for sec in wifiroam_bh wifiroam_bh2; do
		[ "$(uci -q get wireless.$sec.wds)" = "1" ] && uci -q set wireless.$sec.wds='0'
	done

	# 设备名唯一化：同一批机器 hostname 都是 GWRT，拓扑/配对列表里分不清。
	# 用 br-lan MAC 后 4 位做后缀（例：GWRT-73E2），多台同型号一眼可分。
	if [ -z "$(uci -q get wifiroam.core.name)" ]; then
		# 注意：本脚本跑在 uci-defaults（S10boot）阶段，此时 network 还没起，
		# br-lan/wan 都不存在 —— 必须用内核 probe 阶段就有的 eth0，再依次兜底。
		mnl=""
		for _d in eth0 wan lan1 br-lan lo; do
			_m="$(cat /sys/class/net/$_d/address 2>/dev/null | tr -d ':' | tr 'a-z' 'A-Z')"
			[ ${#_m} -eq 12 ] && { mnl="$_m"; break; }
		done
		sfx="$(printf '%s' "$mnl" | tail -c 4)"
		if [ -n "$sfx" ]; then
			uci -q set wifiroam.core.name="GWRT-$sfx"
			# 主机名还是默认 GWRT 时也带上后缀，LuCI/DHCP 列表里同样能区分
			if [ "$(uci -q get system.@system[0].hostname)" = "GWRT" ]; then
				uci -q set system.@system[0].hostname="GWRT-$sfx"
				uci -q commit system
			fi
		fi
	fi
	# 漫游组：把本机 AP 的 SSID 预选进去（同 SSID + 同密码才能无缝漫游）
	# 回传 SSID（mesh-gwrt）是隐藏 WDS AP，绝不能进漫游组
	bh_ssid="$(uci -q get wifiroam.backhaul.ssid)"
	ssids=""
	for i in $(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get "wireless.$i.mode")" = ap ] || continue
		case "$i" in wifiroam_bh*) continue ;; esac
		s="$(uci -q get "wireless.$i.ssid")"
		[ -n "$s" ] || continue
		[ "$s" = "$bh_ssid" ] && continue
		case " $ssids " in *" $s "*) continue ;; esac
		ssids="$ssids $s"
	done
	ssids="$(echo $ssids)"
	# 注意：必须是 UCI list（add_list），写成 "a b" 会被守护进程当成一个 SSID，
	# 结果 802.11k/v/r 一个都匹配不上（roam.ssids 里是带空格的单条字符串）。
	uci -q delete wifiroam.roam.ssids
	for s in $ssids; do
		uci -q add_list wifiroam.roam.ssids="$s"
	done
	[ -n "$ssids" ] && uci -q set wifiroam.roam.enabled='1'

	uci -q commit wifiroam

	[ -x /etc/init.d/wifiroam ] && /etc/init.d/wifiroam restart >/dev/null 2>&1

	# 立即把 k/v/r + FT 参数写到 wireless（守护进程只在 set_roam 时应用，
	# 光改 uci 不会生效，必须调用一次 ubus；要等守护进程起来）
	if [ "$(uci -q get wifiroam.core.role)" = "cap" ] && \
	   [ "$(uci -q get wifiroam.roam.enabled)" = "1" ]; then
		i=0
		while [ "$i" -lt 15 ]; do
			ubus -S list wifiroam >/dev/null 2>&1 && break
			sleep 1
			i=$((i + 1))
		done
		json_ssids=""
		for s in $(uci -q get wifiroam.roam.ssids); do
			json_ssids="$json_ssids\"$s\","
		done
		json_ssids="[${json_ssids%,}]"
		ubus call wifiroam set_roam "{\"enabled\":true,\"ssids\":$json_ssids,\"r_fast\":true,\"ft_mode\":\"simple\",\"ft_over_ds\":true,\"k_neighbor\":true,\"k_beacon\":true,\"v_bss_transition\":true,\"rssi_profile\":\"balanced\",\"rssi_threshold\":-70}" >/dev/null 2>&1 || true
	fi
fi

# 自动配对服务（主 AP 发现未配置 AP 自动配对）
[ -x /etc/init.d/gwrt-wifiroam-autopair ] && {
	/etc/init.d/gwrt-wifiroam-autopair enable >/dev/null 2>&1
}

# 主机名默认 gwrt（仅出厂默认值时改一次，不覆盖用户已改的；
# mesh 拓扑里的唯一名走 wifiroam.core.name=GWRT-$sfx，不受影响）
case "$(uci -q get system.@system[0].hostname)" in
ImmortalWrt|OpenWrt|"")
	uci -q set system.@system[0].hostname='gwrt'
	uci -q commit system
	;;
esac

exit 0
