#!/bin/sh
# Install bundled offline APKs once; retry only failed files within this run.
APKDIR=${GWRT_APK_DIR:-/usr/share/gwrt/apk}
MARK=${GWRT_APK_MARK:-/etc/gwrt/wifiroam-apk.done}
LOG=${GWRT_APK_LOG:-/tmp/gwrt-wifiroam-apk.log}
APKDB=${GWRT_APK_DB:-/lib/apk/db}
BOARD="$(cat /tmp/sysinfo/board_name 2>/dev/null)"

if [ "$BOARD" = 'jdcloud,re-ss-01' ] && [ "${GWRT_SS01_FIRSTBOOT_WORKER:-0}" != 1 ]; then
	printf '%s\n' "$$" > /tmp/gwrt-ss01-uci-defaults.pid
	exit 1
fi

[ -e "$MARK" ] && exit 0
if [ ! -d "$APKDIR" ]; then
	[ "$BOARD" = 'jdcloud,re-ss-01' ] && exit 1
	exit 0
fi
# An empty preset directory (for example a minimal image) needs no DB polling.
set -- "$APKDIR"/*.apk
if [ ! -f "$1" ]; then
	[ "$BOARD" = 'jdcloud,re-ss-01' ] && exit 1
	exit 0
fi

i=0
while [ "$i" -lt 15 ] && [ ! -d "$APKDB" ]; do
	sleep 1
	i=$((i + 1))
done
[ -d "$APKDB" ] || exit 1

failed=0
{
	echo "=== $(date) installing preset APKs from $APKDIR"
	# Socket must precede wifiroam. Do not reinstall successful files in pass 2.
	set --
	for f in "$APKDIR"/*ucode-mod-socket*.apk "$APKDIR"/*.apk; do
		[ -f "$f" ] || continue
		case "$f" in *ucode-mod-socket*)
			[ "${socket_seen:-0}" = 0 ] || continue
			socket_seen=1 ;;
		esac
		echo "--- $(basename "$f")"
		apk add --allow-untrusted --force-non-repository --network=no "$f" 2>&1 || set -- "$@" "$f"
	done
	for f in "$@"; do
		echo "--- retry $(basename "$f")"
		if apk add --allow-untrusted --force-non-repository --network=no "$f" 2>&1; then
			continue
		fi
		# The bundled offline APKs are built for aarch64_cortex-a53, but some
		# targets (e.g. Realtek RTL9617C) report aarch64_cortex-a55.  a53 and
		# a55 are both ARMv8-A, so the payload is compatible; only apk's arch
		# gate rejects it.  Fall back to the known APK build arch before
		# giving up.  Pure-script packages and matching-arch targets never
		# reach this branch, so their behaviour is unchanged.
		echo "--- retry $(basename "$f") with --arch aarch64_cortex-a53"
		apk add --arch aarch64_cortex-a53 --allow-untrusted --force-non-repository --network=no "$f" 2>&1 || failed=1
	done
} >"$LOG" 2>&1

# Verify the DB as well as installer status. Old packages must not mask a failed
# preset upgrade, and incomplete installs must remain pending on every board.
if [ "$failed" = 0 ] && apk info wifiroam >/dev/null 2>&1 && \
   apk info luci-app-wifiroam >/dev/null 2>&1 && \
   { [ "$BOARD" != 'jdcloud,re-ss-01' ] || apk info luci-i18n-wifiroam-zh-cn >/dev/null 2>&1; }; then
	mkdir -p "${MARK%/*}" && echo "ok $(date)" > "$MARK" || exit 1
	rm -rf "$APKDIR"
else
	logger -t gwrt-apk "preset APK install incomplete, see $LOG"
	exit 1
fi
exit 0
