#!/bin/sh /etc/rc.common
# Wait for delayed ath12k/ath11k firmware and bring all enabled radios up.
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/gwrt-wifi-late
	procd_set_param respawn 3600 5 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
