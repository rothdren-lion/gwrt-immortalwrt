#!/bin/sh /etc/rc.common
# GWRT 广告拦截: 读取纯文本规则库(ads-library.txt), 按启用的分类生成
# dnsmasq address= 规则, 以标记块写入 /etc/dnsmasq.conf
#
# 分类: tv(电视核心) tv-ext(电视激进) cn(国内综合) sec(安全软件与更新)
# 固定分类 kill(必拦): 无开关, 总开关开时始终生效 (hao123/2345 等)
#
# 为什么直写 /etc/dnsmasq.conf 而不用 uci conffile/confdir:
#  - 部分固件 dnsmasq init 不支持 uci "conffile" 选项
#  - confdir 随匿名节名变化 (/tmp/dnsmasq.cfg01411c.d) 且 /tmp 开机重建,
#    本服务(START=18)先于 dnsmasq(START=19)运行时目录尚不存在
# /etc/dnsmasq.conf 被所有 OpenWrt dnsmasq init 以 --conf-file= 兜底加载;
# 每次应用先剥掉旧块再按当前配置重写, 重复执行安全

START=18

CFG=gwrt-tv-adblock
DNSCONF=/etc/dnsmasq.conf
LIB_ETC=/etc/gwrt-tv-adblock/ads-library.txt
LIB_SHARE=/usr/share/gwrt-tv-adblock/ads-library.txt
BEGIN="# --- gwrt-tv-adblock begin ---"
END="# --- gwrt-tv-adblock end ---"
LEGACY_TMP=/tmp/dnsmasq.dnsmasq.d/gwrt-tv-ads.conf
RULES_TMP=/tmp/gwrt-tv-adblock.rules.$$

# 布尔值解析: 缺省取 $2, 兼容 1/0 与 true/false/on/off
bool_on() {
	local v="$1" dflt="$2"
	[ -z "$v" ] && v="$dflt"
	case "$v" in
		0|false|off|no|disabled) return 1 ;;
	esac
	return 0
}

# 总开关 (缺省视为开, 兼容旧配置)
is_enabled() {
	bool_on "$(uci -q get ${CFG}.config.enabled 2>/dev/null)" 1
}

# 分类开关; cat_tv 缺省视为开(对齐旧 core 默认), 其余缺省关
cat_on() {
	case "$1" in
		cat_tv) bool_on "$(uci -q get ${CFG}.config.$1 2>/dev/null)" 1 ;;
		*) bool_on "$(uci -q get ${CFG}.config.$1 2>/dev/null)" 0 ;;
	esac
}

enabled_cats() {
	local out=""
	cat_on cat_tv && out="tv"
	cat_on cat_tv_ext && out="$out tv-ext"
	cat_on cat_cn && out="$out cn"
	cat_on cat_sec && out="$out sec"
	echo $out
}

# 活动库: /etc 优先(可被用户替换/升级), 缺失或空文件时自愈自模板恢复
# 用 -s 而非 -f: 0 字节库会让规则全空, 等于静默放行
use_library() {
	if [ -s "$LIB_ETC" ]; then
		echo "$LIB_ETC"
	elif [ -s "$LIB_SHARE" ]; then
		mkdir -p "$(dirname "$LIB_ETC")"
		cp "$LIB_SHARE" "$LIB_ETC" 2>/dev/null && echo "$LIB_ETC" || echo "$LIB_SHARE"
	else
		echo ""
	fi
}

# 从库文件抽取启用分类的域名 → address=/d/ (大小写归一, 去重, 过滤畸形行)
# $1=库文件 $2=要生成的分类(空格分隔); kill 为必拦档, 由调用方无条件追加
# $3=放行清单(空格分隔): dnsmasq 的 address= 优先级高于 server=,
#    同域/子域都救不回来, 所以放行必须在生成阶段就排除, 不能只靠 server=
gen_rules() {
	awk -v cats="$2" -v allow="$3" '
	BEGIN {
		n = split(cats, A, " ")
		for (i = 1; i <= n; i++) en[A[i]] = 1
		m = split(allow, W, " ")
		# 放行项大小写归一: 下方 d 已 tolower, 不归一会导致大写白名单失效
		for (i = 1; i <= m; i++) if (W[i] != "") wl[tolower(W[i])] = 1
	}
	# 域名 d 是否被某个放行项覆盖: 放行项等于 d 或为其父域
	function allowed(d,    p, parts, i) {
		if (d in wl) return 1
		parts = d
		while (match(parts, /\./)) {
			parts = substr(parts, RSTART + 1)
			if (parts in wl) return 1
		}
		return 0
	}
	/^#/ { next }
	/^\[/ {
		cat = $0
		gsub(/^\[/, "", cat); gsub(/\].*$/, "", cat)
		cur = (cat in en) ? 1 : 0
		next
	}
	cur == 1 && NF >= 1 {
		d = tolower($1)
		if (d ~ /^[a-z0-9_.-]+$/ && d !~ /^[.-]/ && d !~ /[.-]$/ && d !~ /\.\./) {
			if (!(d in seen) && !allowed(d)) { seen[d] = 1; print "address=/" d "/" }
		}
	}
	' "$1"
}

# 自定义域名归一与校验: 与 LuCI 侧规则一致(小写/去前导点/合法字符),
# 非法项直接丢弃 —— 原样写入会让 dnsmasq 整份配置起不来, 等于全屋断 DNS
norm_domain() {
	local d
	d=$(echo "$1" | tr 'A-Z' 'a-z')
	while :; do case "$d" in .*) d="${d#.}" ;; *) break ;; esac; done
	case "$d" in
		""|"*..*"|*[!a-z0-9._-]*|*.) return 1 ;;
	esac
	echo "$d"
}

gen_custom() {
	local d n
	for d in $(uci -q get ${CFG}.config.custom_block 2>/dev/null); do
		n="$(norm_domain "$d")" || continue
		echo "address=/$n/"
	done
	# 放行: 必须带目标。dnsmasq 的裸 server=/d/ 是"本地权威"语义(只查
	# /etc/hosts 与 DHCP 租约, 不转发), 放行会等于继续拦死; 用 # 表示
	# "按标准上游解析", 不依赖具体上游 IP, 换网络也不会失效。
	for d in $(uci -q get ${CFG}.config.custom_allow 2>/dev/null); do
		n="$(norm_domain "$d")" || continue
		echo "server=/$n/#"
	done
}

# 剥掉旧标记块, 保留块外内容
strip_block() {
	[ -f "$DNSCONF" ] || { : > "$DNSCONF"; return 0; }
	awk -v b="$BEGIN" -v e="$END" '
		$0 == b { inblk = 1; next }
		$0 == e { inblk = 0; next }
		!inblk { print }
	' "$DNSCONF" > "${DNSCONF}.new" && mv "${DNSCONF}.new" "$DNSCONF"
}

# 一次性清理早期版本遗留: uci conffile 列表 + /tmp 旧生成文件 + 旧规则文件
# (uci del_list 对不存在条目也返回0, 不能用失败判断做循环; 部分固件无 remove 命令)
cleanup_legacy() {
	if uci -q get dhcp.@dnsmasq[0].conffile >/dev/null 2>&1; then
		local cur out=""
		for cur in $(uci -q get dhcp.@dnsmasq[0].conffile 2>/dev/null); do
			case "$cur" in
				/usr/share/gwrt-tv-adblock/*|/etc/gwrt-tv-adblock/*) ;;
				*) out="$out $cur" ;;
			esac
		done
		uci -q delete dhcp.@dnsmasq[0].conffile 2>/dev/null
		if [ -n "$out" ]; then
			for cur in $out; do
				uci add_list dhcp.@dnsmasq[0].conffile="$cur"
			done
		fi
		uci commit dhcp
	fi
	# conf-dir 名称随匿名节变化 (/tmp/dnsmasq.<id>.d), 用通配一次清干净
	rm -f /tmp/dnsmasq*.d/gwrt-tv-ads.conf "$LEGACY_TMP"
	rmdir /tmp/dnsmasq.dnsmasq.d 2>/dev/null
	# v2 遗留: 旧分档规则文件已由库文件取代
	rm -f /usr/share/gwrt-tv-adblock/tv-ads-core.conf \
	      /usr/share/gwrt-tv-adblock/tv-ads-extended.conf
}

# 先在新文件里生成并校验, 通过后才替换旧块:
# 库缺失/损坏/自定义项异常时保留上一次的有效规则, 不静默放行
apply_mode() {
	local on=1 lib n
	cleanup_legacy
	is_enabled || on=0

	if [ "$on" = 1 ]; then
		lib="$(use_library)"
		if [ -z "$lib" ]; then
			logger -t gwrt-tv-adblock "规则库缺失, 保留原规则不变"
			return 1
		fi
		# 放行清单参与规则生成: address= 优先于 server=, 必须在生成阶段排除
		{
			# kill 档无开关: 总开关开启即始终拦截
			gen_rules "$lib" "$(enabled_cats) kill" \
				"$(uci -q get ${CFG}.config.custom_allow 2>/dev/null)"
			gen_custom
		} > "$RULES_TMP"
		n=$(grep -c . "$RULES_TMP" 2>/dev/null)
		if [ "${n:-0}" -lt 1 ]; then
			logger -t gwrt-tv-adblock "规则库无有效域名($lib), 保留原规则不变"
			rm -f "$RULES_TMP"
			return 1
		fi
		# 语法自检: 畸形自定义项不得写进 /etc/dnsmasq.conf
		if command -v dnsmasq >/dev/null 2>&1 && \
		   ! dnsmasq --test -C "$RULES_TMP" >/dev/null 2>&1; then
			logger -t gwrt-tv-adblock "生成规则语法校验失败, 保留原规则不变"
			rm -f "$RULES_TMP"
			return 1
		fi
	fi

	strip_block
	if [ "$on" = 1 ]; then
		{ echo "$BEGIN"; cat "$RULES_TMP"; echo "$END"; } >> "$DNSCONF"
		rm -f "$RULES_TMP"
	fi
	sync
}

boot() {
	# 开机由 rcS 在本服务(START=18)先于 dnsmasq(START=19) 调用,
	# 规则先落盘, dnsmasq 启动即加载, 无需重启
	apply_mode
}

start() {
	# 运行期手动/uci-defaults 启动: dnsmasq 已在运行则让它重读, 否则下次启动自然生效
	apply_mode
	pgrep dnsmasq >/dev/null 2>&1 && /etc/init.d/dnsmasq restart 2>/dev/null
	return 0
}

stop() {
	strip_block
	sync
	# 本服务不拥有 dnsmasq; 仅当其在运行时让它重读配置
	pgrep dnsmasq >/dev/null 2>&1 && /etc/init.d/dnsmasq restart 2>/dev/null
	return 0
}

# 运行期切换/改自定义/更新库后: CLI 与 LuCI 调用
reload() {
	apply_mode
	# 本服务不拥有 dnsmasq: 未运行时重启会把它拉起来
	pgrep dnsmasq >/dev/null 2>&1 && /etc/init.d/dnsmasq restart 2>/dev/null
	return 0
}
