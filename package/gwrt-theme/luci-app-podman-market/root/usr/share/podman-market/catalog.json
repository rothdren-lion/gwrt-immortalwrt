  {
    "id": "nginx",
    "name": "Nginx",
    "desc": "高性能 Web 服务器 / 反向代理",
    "icon": "nginx.png",
    "image": "docker.io/library/nginx:alpine",
    "web": "http://<ip>:8080",
    "ports": [
      {
        "h": 8080,
        "c": 80,
        "proto": "tcp"
      }
    ],
    "volumes": [
      "html:/usr/share/nginx/html",
      "conf.d:/etc/nginx/conf.d"
    ],
    "env": [],
    "extra": [],
    "pre": [
      "mkdir -p \"$DATA/html\" \"$DATA/conf.d\"",
      "[ -f \"$DATA/html/index.html\" ] || echo \"<h1>Podman Market Nginx</h1>\" > \"$DATA/html/index.html\"",
      "[ -f \"$DATA/conf.d/default.conf\" ] || echo \"server { listen 80; root /usr/share/nginx/html; }\" > \"$DATA/conf.d/default.conf\""
    ]
  },
