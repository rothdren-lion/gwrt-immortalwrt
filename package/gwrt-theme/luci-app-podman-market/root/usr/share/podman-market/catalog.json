  {
    "id": "mosquitto",
    "name": "Mosquitto",
    "desc": "轻量级 MQTT 消息服务器",
    "icon": "mosquitto.png",
    "image": "docker.io/eclipse-mosquitto:2",
    "web": "",
    "ports": [
      {
        "h": 1883,
        "c": 1883,
        "proto": "tcp"
      }
    ],
    "volumes": [
      "config:/mosquitto/config",
      "data:/mosquitto/data",
      "log:/mosquitto/log"
    ],
    "env": [],
    "extra": [],
    "pre": [
      "mkdir -p \"$DATA/config\"",
      "[ -f \"$DATA/config/mosquitto.conf\" ] || echo \"listener 1883\" > \"$DATA/config/mosquitto.conf\"",
      "[ -f \"$DATA/config/mosquitto.conf\" ] || echo \"allow_anonymous true\" >> \"$DATA/config/mosquitto.conf\"",
      "[ -f \"$DATA/config/mosquitto.conf\" ] || echo \"persistence true\" >> \"$DATA/config/mosquitto.conf\"",
      "[ -f \"$DATA/config/mosquitto.conf\" ] || echo \"persistence_location /mosquitto/data/\" >> \"$DATA/config/mosquitto.conf\"",
      "[ -f \"$DATA/config/mosquitto.conf\" ] || echo \"log_dest file /mosquitto/log/mosquitto.log\" >> \"$DATA/config/mosquitto.conf\""
    ]
  },
