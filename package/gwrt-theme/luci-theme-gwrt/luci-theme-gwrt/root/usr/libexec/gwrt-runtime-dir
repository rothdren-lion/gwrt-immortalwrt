#!/bin/sh

set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
runtime_dir=/tmp/gwrt-theme

if [ ! -e "$runtime_dir" ] && [ ! -L "$runtime_dir" ]; then
	(umask 077; mkdir "$runtime_dir") 2>/dev/null || true
fi

[ -d "$runtime_dir" ] && [ ! -L "$runtime_dir" ] || exit 1
# OpenWrt's minimal BusyBox does not always provide stat. Numeric ls output
# keeps the ownership check independent of usernames and optional applets.
owner=$(LC_ALL=C ls -nd "$runtime_dir" 2>/dev/null | awk 'NR == 1 {print $3}') || exit 1
[ "$owner" = 0 ] || exit 1
chmod 700 "$runtime_dir" || exit 1

printf '%s\n' "$runtime_dir"
