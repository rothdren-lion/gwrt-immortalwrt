    "eqos",
    "firewall",
    "gwrt",
    "network",
    "system",
    "wireless",
    "pon_wan"
   ],
   "file": {
    "/usr/libexec/syslog-wrapper": [
     "exec"
    ],
    "/usr/libexec/gwrt-ota status": [
     "exec"
    ],
    "/usr/libexec/gwrt-ota check": [
     "exec"
    ],
    "/usr/libexec/gwrt-conntrack": [
     "exec"
    ],
    "/bin/cat /proc/stat": [
     "exec"
    ],
    "/bin/cat /sys/kernel/debug/clk/clk_summary": [
     "exec"
    ],
    "/bin/cat /sys/class/thermal/thermal_zone0/temp": [
     "exec"
    ],
    "/sys/devices/soc0/machine": [
     "read"
    ],
    "/etc/bench.log": [
     "read"
    ],
    "/etc/coremark.sh": [
     "read"
    ],
    "/proc/cpuinfo": [
     "read"
    ],
    "/proc/net/nf_conntrack": [
     "read"
    ],
    "/proc/net/dev": [
     "read"
