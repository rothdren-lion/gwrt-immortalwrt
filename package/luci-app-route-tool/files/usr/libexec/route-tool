#!/bin/sh
# route-tool backend - OpenWrt router partition backup/write helper
# by 数码罗记 · godsun.pro

PATH=/usr/sbin:/usr/bin:/sbin:/bin
LOCK=/tmp/route-tool.lock
ALLOW_PARTS="gpt cdt art ART appsbl factory mibib bl2 BL2 fip FIP config Config u-boot uboot"
COMMON=/usr/libexec/route-tool.d/storage_common.sh
[ -r "$COMMON" ] || COMMON="${0%/*}/route-tool.d/storage_common.sh"
[ -r "$COMMON" ] && . "$COMMON"
PARTITION=/usr/libexec/route-tool.d/storage_partition.sh
[ -r "$PARTITION" ] || PARTITION="${0%/*}/route-tool.d/storage_partition.sh"
[ -r "$PARTITION" ] && . "$PARTITION"
SWAPLIB=/usr/libexec/route-tool.d/storage_swap.sh
[ -r "$SWAPLIB" ] || SWAPLIB="${0%/*}/route-tool.d/storage_swap.sh"
[ -r "$SWAPLIB" ] && . "$SWAPLIB"

err(){ echo "$*" >&2; }
json_escape(){ sed 's/\\/\\\\/g; s/"/\\"/g'; }
is_real_mtd_sysfs(){
    base="${1##*/}"
    case "$base" in mtd[0-9]*) ;; *) return 1 ;; esac
    case "${base#mtd}" in ''|*[!0-9]*) return 1 ;; esac
    return 0
}
is_nand_type(){ case "$1" in *nand*|NAND*) return 0 ;; esac; return 1; }
part_label(){
    case "$1" in
        appsbl) echo "U-Boot / appsbl" ;;
        mibib) echo "mibib / NAND分区表" ;;
        cdt) echo "cdt / 内存识别" ;;
        art|ART) echo "$1 / 无线校准" ;;
        factory) echo "factory / EEPROM校准" ;;
        bl2|BL2) echo "$1 / Preloader" ;;
        fip|FIP) echo "$1 / U-Boot" ;;
        u-boot|uboot) echo "U-Boot" ;;
        *) echo "$1" ;;
    esac
}
part_note(){
    case "$1" in
        cdt) echo "高通内存识别文件；没有硬改内存不要碰它" ;;
        art|ART) echo "无线校准/MAC 数据，务必先备份" ;;
        factory) echo "校准/EEPROM 数据，务必先备份" ;;
        appsbl|u-boot|uboot) echo "U-Boot 分区，写错可能变砖" ;;
        mibib) echo "NAND 分区表，写错可能导致分区错乱" ;;
        bl2|BL2) echo "MTK BL2/Preloader 分区，写错可能变砖" ;;
        fip|FIP) echo "MTK FIP/U-Boot 分区，写错可能变砖" ;;
        *) echo "" ;;
    esac
}
critical_part(){
    case "$1" in
        gpt|appsbl|bl2|BL2|fip|FIP|mibib) return 0 ;;
    esac
    return 1
}
allowed_part(){
    p="$1"
    for a in $ALLOW_PARTS; do [ "$p" = "$a" ] && return 0; done
    return 1
}
md5_of_file(){ md5sum "$1" 2>/dev/null | awk '{print $1}'; }
md5_of_block_prefix(){
    dev="$1"; bytes="$2"; tmp="/tmp/route-tool-md5-$$.bin"
    dd if="$dev" of="$tmp" bs=1 count="$bytes" 2>/dev/null || return 1
    md5_of_file "$tmp"
    rm -f "$tmp"
}
md5_of_mtd_prefix(){
    dev="$1"; bytes="$2"; tmp="/tmp/route-tool-md5-$$.bin"; mtdnum="$(basename "$dev")"; mtype="$(cat /sys/class/mtd/$mtdnum/type 2>/dev/null || echo unknown)"
    if command -v nanddump >/dev/null 2>&1 && is_nand_type "$mtype"; then
        nanddump -l "$bytes" -f "$tmp" "$dev" >/tmp/route-tool-nanddump-$$.log 2>&1 || return 1
    else
        dd if="$dev" of="$tmp" bs=1 count="$bytes" 2>/dev/null || return 1
    fi
    md5_of_file "$tmp"
    rm -f "$tmp" /tmp/route-tool-nanddump-$$.log
}
check_bad_blocks(){
    dev="$1"; mtdnum="$(basename "$dev")"; mtype="$(cat /sys/class/mtd/$mtdnum/type 2>/dev/null || echo unknown)"
    is_nand_type "$mtype" || return 0
    bad="$(cat /sys/class/mtd/$mtdnum/bad_blocks 2>/dev/null || echo 0)"
    [ "$bad" = "0" ] || echo "警告：检测到 NAND 坏块数量：$bad。写入后 MD5 若不一致，可能与坏块/跳块/OOB 处理有关，请谨慎确认。"
}
lock_begin(){
    # Nested calls (one click flow) reuse the lock taken by the outer command.
    [ "${RT_LOCKED:-0}" = "1" ] && return 0
    if ! mkdir "$LOCK" 2>/dev/null; then err "已有备份/写入任务正在执行，请稍后再试"; exit 8; fi
    RT_LOCKED=1
    trap 'rm -rf "$LOCK"; [ -n "${TMPFILE:-}" ] && rm -f "$TMPFILE"' EXIT INT TERM
}

find_emmc(){
    for d in /sys/block/mmcblk*; do
        [ -f "$d/device/type" ] || continue
        t="$(cat "$d/device/type" 2>/dev/null)"
        [ "$t" = "MMC" ] || continue
        b="$(basename "$d")"
        [ -b "/dev/$b" ] && { echo "/dev/$b"; return 0; }
    done
    return 1
}

find_emmc_part(){
    target="$1"; emmc="${2:-}"
    if [ -n "$emmc" ]; then
        bases="$(basename "$emmc")"
    else
        # Search every MMC block device so systems with eMMC exposed as mmcblk1 are handled.
        bases=""
        for d in /sys/block/mmcblk*; do
            [ -f "$d/device/type" ] || continue
            [ "$(cat "$d/device/type" 2>/dev/null)" = "MMC" ] || continue
            b="$(basename "$d")"
            bases="${bases}${bases:+ }$b"
        done
    fi
    target_lc="$(printf '%s' "$target" | tr 'A-Z' 'a-z')"
    for base in $bases; do
        for p in /sys/block/$base/${base}p*; do
            [ -f "$p/uevent" ] || continue
            raw="$(sed -n 's/^PARTNAME=//p' "$p/uevent" 2>/dev/null | head -n 1)"
            name="$raw"
            case "$name" in 0:*) name="${name#0:}" ;; esac
            name_lc="$(printf '%s' "$name" | tr 'A-Z' 'a-z')"
            [ "$name_lc" = "$target_lc" ] || continue
            dev="/dev/$(basename "$p")"
            [ -b "$dev" ] && { echo "$dev"; return 0; }
        done
    done
    return 1
}


find_emmc_boot_part(){
    target="$1"; emmc="$2"
    [ -n "$emmc" ] || return 1
    case "$target" in bl2|BL2) ;; *) return 1 ;; esac
    compat="$(tr '\000' ' ' </proc/device-tree/compatible 2>/dev/null | tr 'A-Z' 'a-z')"
    model="$(cat /tmp/sysinfo/model /proc/device-tree/model 2>/dev/null | head -n 1 | tr 'A-Z' 'a-z')"
    case "$compat $model" in *mediatek*|*mt762*|*mt798*) ;; *) return 1 ;; esac
    base="$(basename "$emmc")"
    for boot in /sys/block/${base}boot0 /sys/class/block/${base}boot0; do
        [ -r "$boot/size" ] || continue
        dev="/dev/${boot##*/}"
        [ -b "$dev" ] && { echo "$dev"; return 0; }
    done
    return 1
}

find_mtd_line(){
    target="$1"
    [ -r /proc/mtd ] || return 1
    awk -v n="$target" '
        function norm(s) { sub(/^0:/, "", s); return tolower(s) }
        $1 ~ /^mtd[0-9]+:/ {
            dev=$1; sub(/:$/, "", dev)
            size=$2; erase=$3
            name=$0
            sub(/^[^"]*"/, "", name)
            sub(/".*$/, "", name)
            if (norm(name) == tolower(n)) {
                print dev " " size " " erase " " name
                exit
            }
        }
    ' /proc/mtd
}

find_mtd_dev(){
    line="$(find_mtd_line "$1")" || return 1
    set -- $line
    [ -n "$1" ] || return 1
    echo "/dev/$1"
}

mtd_size(){
    line="$(find_mtd_line "$1")" || return 1
    set -- $line
    printf "%d\n" "0x$2" 2>/dev/null
}

block_size(){
    dev="$1"; base="$(basename "$dev")"
    if command -v blockdev >/dev/null 2>&1; then
        blockdev --getsize64 "$dev" 2>/dev/null && return 0
    fi
    [ -r "/sys/class/block/$base/size" ] || return 1
    sec="$(cat "/sys/class/block/$base/size" 2>/dev/null)"
    [ -n "$sec" ] || return 1
    echo $((sec * 512))
}

emmc_manf_name(){
    # Use shared mapping so JSON list/detail/analyze agree on manufacturer names.
    if command -v rt_emmc_chip_name >/dev/null 2>&1; then
        rt_emmc_chip_name "$1" "$2"
    elif command -v rt_emmc_manf_name >/dev/null 2>&1; then
        rt_emmc_manf_name "$1"
    else
        case "$1" in 88|d6|D6) echo "Longsys(江波龙)" ;; "") echo "未知" ;; *) echo "未知(0x$1)" ;; esac
    fi
}

emmc_health_text(){
    out="$(/usr/libexec/route-tool.d/storage_health.sh 2>/dev/null | sed -n 's/^EMMC_LIFE_TEXT=//p' | head -n 1)"
    [ -n "$out" ] && { echo "$out"; return; }
    echo "N/A"
}

nand_brand_guess(){
    out=""
    for f in /sys/class/mtd/mtd*/device/modalias /sys/class/mtd/mtd*/device/name /sys/class/mtd/mtd*/name; do
        [ -r "$f" ] || continue
        v="$(cat "$f" 2>/dev/null | head -n 1)"
        case "$v" in
            *spi*|*nand*|*NAND*|*flash*|*Flash*) out="$v"; break ;;
        esac
    done
    if [ -z "$out" ]; then
        out="$(dmesg 2>/dev/null | grep -i 'spinand\|spi-nand\|winbond\|gigadevice\|macronix\|micron\|toshiba\|kioxia\|esmt\|foresee' | tail -n 1 | sed 's/^.*] //')"
    fi
    case "$out" in
        *Winbond*|*winbond*|*W25*) echo "Winbond(华邦) $out" ;;
        *GigaDevice*|*gigadevice*|*GD5*|*gd5*) echo "GigaDevice(兆易创新) $out" ;;
        *Macronix*|*macronix*|*MX*) echo "Macronix(旺宏) $out" ;;
        *Micron*|*micron*|*MT29*) echo "Micron(美光) $out" ;;
        *Toshiba*|*Kioxia*|*toshiba*|*kioxia*) echo "Toshiba/Kioxia(东芝/铠侠) $out" ;;
        *ESMT*|*esmt*) echo "ESMT(晶豪) $out" ;;
        *FORESEE*|*Foresee*|*foresee*) echo "FORESEE(江波龙) $out" ;;
        "") echo "未知" ;;
        spi:spi-nand|spi-nand) echo "SPI-NAND(内核未导出具体品牌)" ;;
        *) echo "$out" ;;
    esac
}

has_spi_mtd(){
    for m in /sys/class/mtd/mtd*; do
        is_real_mtd_sysfs "$m" || continue
        for f in "$m/device/modalias" "$m/device/uevent" "$m/device/name"; do
            [ -r "$f" ] || continue
            value="$(cat "$f" 2>/dev/null | head -n 1)"
            case "$value" in *spi*) return 0 ;; esac
        done
    done
    return 1
}

storage_kind(){
    case "$1:$2:$3" in
        1:*:1) echo "spi+emmc" ;;
        1:*:*) echo "emmc" ;;
        *:1:1) echo "spi+nand" ;;
        *:1:*) echo "nand" ;;
        *:*:1) echo "spi" ;;
        *) echo "unknown" ;;
    esac
}
storage_json(){
    emmc="$1"; base="$(basename "$emmc" 2>/dev/null)"
    printf '"storage":{'
    printf '"emmc":{"present":%s' "$([ -n "$emmc" ] && echo true || echo false)"
    if [ -n "$emmc" ]; then
        cid="$(cat /sys/class/block/$base/device/cid /sys/block/$base/device/cid 2>/dev/null | head -n 1)"
        # CID offsets: MID=1-2, OID=5-6, PNM=7-18, PRV=19-20, PSN=21-28
        manfid="$(printf '%s' "$cid" | cut -c1-2)"
        prod_hex="$(printf '%s' "$cid" | cut -c7-18)"
        fw="$(printf '%s' "$cid" | cut -c19-20)"
        serial="$(printf '%s' "$cid" | cut -c21-28)"
        maker="$(emmc_manf_name "$manfid" "$prod_hex")"
        if command -v rt_hex2ascii >/dev/null 2>&1; then
            prod="$(rt_hex2ascii "$prod_hex")"
        else
            prod="$prod_hex"
        fi
        [ -n "$prod" ] || prod="$prod_hex"
        cap="$(block_size "$emmc" 2>/dev/null || echo 0)"
        health="$(emmc_health_text)"
        printf ',"dev":"%s","manufacturer":"%s","manufacturer_id":"0x%s","product":"%s","fwrev":"%s","serial":"%s","cid":"%s","capacity":%s,"health":"%s"' \
            "$(printf '%s' "$emmc" | json_escape)" "$(printf '%s' "$maker" | json_escape)" "$(printf '%s' "$manfid" | json_escape)" "$(printf '%s' "$prod" | json_escape)" "$(printf '%s' "$fw" | json_escape)" "$(printf '%s' "$serial" | json_escape)" "$(printf '%s' "$cid" | json_escape)" "$cap" "$(printf '%s' "$health" | json_escape)"
    fi
    printf '},'
    nand_present=false; nand_cnt=0; nand_bad=0
    if [ -r /proc/mtd ]; then
        for m in /sys/class/mtd/mtd*; do
            [ -r "$m/type" ] || continue
            t="$(cat "$m/type" 2>/dev/null)"
            is_real_mtd_sysfs "$m" || continue
            case "$t" in *nand*|nand|mlc-nand|slc-nand) nand_present=true; nand_cnt=$((nand_cnt+1)); b="$(cat "$m/bad_blocks" 2>/dev/null || echo 0)"; nand_bad=$((nand_bad+b)) ;; esac
        done
    fi
    if [ "$nand_present" = true ]; then brand="$(nand_brand_guess)"; else brand=""; fi
    emmc_flag=0; [ -n "$emmc" ] && emmc_flag=1
    nand_flag=0; [ "$nand_present" = true ] && nand_flag=1
    spi_flag=0; has_spi_mtd && spi_flag=1
    kind="$(storage_kind "$emmc_flag" "$nand_flag" "$spi_flag")"
    case "$kind" in
        spi+emmc) label="SPI + eMMC" ;;
        emmc) label="eMMC" ;;
        spi+nand) label="SPI + NAND" ;;
        nand) label="NAND" ;;
        spi) label="SPI" ;;
        *) label="未知" ;;
    esac
    printf '"nand":{"present":%s,"brand":"%s","chips":%s,"bad_blocks":%s},"kind":"%s","label":"%s",' "$nand_present" "$(printf '%s' "$brand" | json_escape)" "$nand_cnt" "$nand_bad" "$kind" "$label"
    printf '"extra":['
    detect_extra_storage_json
    printf ']'
    printf '}'
}

detect_extra_storage_json(){
    first=1
    df -P -k 2>/dev/null | awk 'NR>1 {print $1"|"$2"|"$6}' | while IFS='|' read dev kb mp; do
        case "$dev" in /dev/sd*|/dev/nvme*|/dev/hd*) ;;
            *) continue ;;
        esac
        [ -n "$mp" ] || mp=""
        base="$(basename "$dev")"
        disk="$base"
        case "$base" in sd*[0-9]) disk="$(printf '%s' "$base" | sed 's/[0-9]*$//')" ;; nvme*n[0-9]p[0-9]*) disk="$(printf '%s' "$base" | sed 's/p[0-9]*$//')" ;; esac
        typ="USB/外置"
        case "$disk" in nvme*) typ="M.2/NVMe" ;; sd*) typ="USB/SATA" ;; hd*) typ="SATA/IDE" ;; esac
        bytes=$((kb * 1024))
        [ $first -eq 0 ] && printf ','
        printf '{"type":"%s","dev":"%s","mount":"%s","size":%s}' "$(printf '%s' "$typ" | json_escape)" "$(printf '%s' "$dev" | json_escape)" "$(printf '%s' "$mp" | json_escape)" "$bytes"
        first=0
    done
}

file_size(){ wc -c < "$1" | tr -d ' '; }

part_type(){
    part="$1"; emmc="$(find_emmc 2>/dev/null || true)"
    if [ -n "$emmc" ] && [ "$part" != "gpt" ]; then
        dev="$(find_emmc_part "$part" "$emmc" 2>/dev/null || true)"
        [ -n "$dev" ] && { echo "block $dev"; return 0; }
        dev="$(find_emmc_boot_part "$part" "$emmc" 2>/dev/null || true)"
        [ -n "$dev" ] && { echo "block_boot $dev"; return 0; }
    fi
    mtd="$(find_mtd_dev "$part" 2>/dev/null || true)"
    [ -n "$mtd" ] && { echo "mtd $mtd"; return 0; }
    return 1
}

storage_unalloc_mb(){
    # 检测eMMC末尾未分配空间(MB): 末分区结束扇区到磁盘尾, 对齐1MB
    base="$(basename "$1" 2>/dev/null)"
    [ -n "$base" ] && [ -f "/sys/class/block/$base/size" ] || { echo 0; return; }
    last_end=0
    for p in /sys/class/block/${base}p*; do
        [ -f "$p/size" ] && [ -f "$p/start" ] || continue
        pe=$(( $(cat "$p/start" 2>/dev/null || echo 0) + $(cat "$p/size" 2>/dev/null || echo 0) - 1 ))
        [ "$pe" -gt "$last_end" ] 2>/dev/null && last_end=$pe
    done
    [ "$last_end" -gt 0 ] 2>/dev/null || { echo 0; return; }
    disk_end=$(( $(cat /sys/class/block/$base/size) - 1 ))
    next_start=$(( (last_end + 1 + 2047) / 2048 * 2048 ))
    if [ "$next_start" -le "$disk_end" ] 2>/dev/null; then
        echo $(( (disk_end - next_start + 1) * 512 / 1024 / 1024 ))
    else
        echo 0
    fi
}

list_json(){
    emmc="$(find_emmc 2>/dev/null || true)"
    printf '{"name":"route-tool","footer":"by 数码罗记 · godsun.pro","emmc":"%s","has_gpt":%s,' "$(printf '%s' "$emmc" | json_escape)" "$([ -n "$emmc" ] && echo true || echo false)"
    storage_json "$emmc"
    printf ',"unallocated_mb":%s' "$(storage_unalloc_mb "$emmc")"
    printf ',"parts":['
    first=1
    if [ -n "$emmc" ]; then
        printf '%s{"name":"gpt","label":"GPT 分区表","kind":"gpt","dev":"%s","size":17408,"can_backup":true,"can_write":true,"danger":true,"note":"eMMC GPT 前34扇区备份，约17KB；包含保护MBR、主GPT头和分区项"}' "$([ $first -eq 1 ] && echo '' || echo ',')" "$(printf '%s' "$emmc" | json_escape)"; first=0
        for p in cdt art appsbl factory mibib bl2 fip; do
            dev="$(find_emmc_part "$p" "$emmc" 2>/dev/null || true)"
            [ -n "$dev" ] || continue
            sz="$(block_size "$dev" 2>/dev/null || echo 0)"
            label="$(part_label "$p")"
            crit=false; critical_part "$p" && crit=true
            note="$(part_note "$p")"
            printf '%s{"name":"%s","label":"%s","kind":"block","dev":"%s","size":%s,"can_backup":true,"can_write":true,"danger":true,"critical":%s,"note":"%s"}' "$([ $first -eq 1 ] && echo '' || echo ',')" "$p" "$label" "$(printf '%s' "$dev" | json_escape)" "$sz" "$crit" "$(printf '%s' "$note" | json_escape)"; first=0
        done
        for p in bl2; do
            dev="$(find_emmc_part "$p" "$emmc" 2>/dev/null || true)"
            [ -n "$dev" ] && continue
            dev="$(find_emmc_boot_part "$p" "$emmc" 2>/dev/null || true)"
            [ -n "$dev" ] || continue
            sz="$(block_size "$dev" 2>/dev/null || echo 0)"
            crit=false; critical_part "$p" && crit=true
            note="$(part_note "$p")；检测到 eMMC boot0 候选区，仅在确认本机 BL2/Preloader 位于 boot0 时写入"
            printf '%s{"name":"%s","label":"%s","kind":"block_boot","dev":"%s","size":%s,"can_backup":true,"can_write":true,"danger":true,"critical":%s,"candidate":true,"note":"%s"}' "$([ $first -eq 1 ] && echo '' || echo ',')" "$p" "$(part_label "$p")" "$(printf '%s' "$dev" | json_escape)" "$sz" "$crit" "$(printf '%s' "$note" | json_escape)"; first=0
        done
    fi
    if [ -r /proc/mtd ]; then
        for p in mibib cdt appsbl art factory fip bl2 u-boot uboot config; do
            line="$(find_mtd_line "$p" 2>/dev/null || true)"
            [ -n "$line" ] || continue
            set -- $line; mtdnum="$1"; size="$(printf "%d" "0x$2" 2>/dev/null || echo 0)"; type="$(cat /sys/class/mtd/$mtdnum/type 2>/dev/null || echo mtd)"
            label="$(part_label "$p")"
            crit=false; critical_part "$p" && crit=true
            note="$(part_note "$p")"
            bad="$(cat /sys/class/mtd/$mtdnum/bad_blocks 2>/dev/null || echo 0)"
            printf '%s{"name":"%s","label":"%s","kind":"mtd","dev":"/dev/%s","mtd_type":"%s","size":%s,"bad_blocks":%s,"can_backup":true,"can_write":true,"danger":true,"critical":%s,"note":"%s"}' "$([ $first -eq 1 ] && echo '' || echo ',')" "$p" "$label" "$mtdnum" "$type" "$size" "$bad" "$crit" "$(printf '%s' "$note" | json_escape)"; first=0
        done
    fi
    printf ']}'
}

backup_gpt(){
    emmc="$(find_emmc)" || { err "当前设备未发现 eMMC，不能备份 GPT"; exit 3; }
    # sgdisk --backup on some OpenWrt builds creates a 0-byte file. For this router use-case,
    # export the protective MBR + primary GPT header/partition entries directly.
    # 34 sectors * 512B = 17408B (about 17KB), matching the field requirement.
    dd if="$emmc" bs=512 count=34 2>/dev/null || { err "GPT 前 34 扇区备份失败"; exit 6; }
}

backup_part(){
    part="$1"; allowed_part "$part" || { err "不支持的分区：$part"; exit 2; }
    [ "$part" = "gpt" ] && { backup_gpt; return; }
    set -- $(part_type "$part" 2>/dev/null) || { err "未找到分区：$part"; exit 3; }
    kind="$1"; dev="$2"
    TMPFILE="/tmp/route-tool-${part}-$$.bin"
    if [ "$kind" = "block" ]; then
        dd if="$dev" bs=1M 2>/dev/null
    else
        if command -v nanddump >/dev/null 2>&1 && is_nand_type "$(cat /sys/class/mtd/$(basename "$dev")/type 2>/dev/null)"; then
            nanddump -f "$TMPFILE" "$dev" >/dev/null 2>&1 || { err "NAND 备份失败：$part"; exit 6; }
            cat "$TMPFILE"
        else
            dd if="$dev" bs=64k 2>/dev/null
        fi
    fi
}

restore_gpt(){
    file="$1"; confirm="$2"
    [ "$confirm" = "YES" ] || { err "写入/恢复需要确认参数 YES"; exit 7; }
    emmc="$(find_emmc)" || { err "当前设备未发现 eMMC，不能恢复 GPT"; exit 3; }
    command -v sgdisk >/dev/null 2>&1 || { err "缺少 sgdisk，请安装 gdisk 包"; exit 4; }
    [ -s "$file" ] || { err "上传文件为空或不存在"; exit 5; }
    lock_begin
    sgdisk --backup="/tmp/route-tool-gpt-before-restore-$$.bin" "$emmc" >/dev/null 2>&1 || true
    sgdisk --load-backup="$file" "$emmc" >/dev/null 2>&1 || { err "GPT 恢复失败"; exit 6; }
    sync
    echo "GPT 分区表已恢复，建议立即重启路由器。"
}

write_part(){
    part="$1"; file="$2"; confirm="$3"
    allowed_part "$part" || { err "不支持的分区：$part"; exit 2; }
    [ "$confirm" = "YES" ] || { err "写入需要确认参数 YES"; exit 7; }
    [ -s "$file" ] || { err "上传文件为空或不存在"; exit 5; }
    [ "$part" = "gpt" ] && { restore_gpt "$file" "$confirm"; return; }
    set -- $(part_type "$part" 2>/dev/null) || { err "未找到分区：$part"; exit 3; }
    kind="$1"; dev="$2"; fsz="$(file_size "$file")"
    [ "$fsz" -ge 4096 ] || { err "镜像文件过小，疑似错误文件"; exit 5; }
    lock_begin
    if [ "$kind" = "block" ] || [ "$kind" = "block_boot" ]; then
        psz="$(block_size "$dev" 2>/dev/null || echo 0)"
        [ "$psz" -gt 0 ] && [ "$fsz" -le "$psz" ] || { err "镜像大于目标分区，已取消"; exit 5; }
        bbase="$(basename "$dev")"; force_ro="/sys/class/block/$bbase/force_ro"; old_force_ro=""
        if [ -r "$force_ro" ]; then
            old_force_ro="$(cat "$force_ro" 2>/dev/null)"
            [ "$old_force_ro" = "1" ] && echo 0 > "$force_ro" 2>/dev/null || true
        fi
        dd if="$dev" of="/tmp/route-tool-${part}-before-write-$$.bin" bs=1M 2>/dev/null || true
        before_md5="$(md5_of_block_prefix "$dev" "$fsz" 2>/dev/null || echo unknown)"
        file_md5="$(md5_of_file "$file" 2>/dev/null || echo unknown)"
        echo "写入前：分区前 ${fsz} 字节 MD5=$before_md5，文件 MD5=$file_md5"
        dd if="$file" of="$dev" bs=1M 2>/dev/null || { [ -n "$old_force_ro" ] && echo "$old_force_ro" > "$force_ro" 2>/dev/null || true; err "eMMC 分区写入失败"; exit 6; }
        sync
        [ -n "$old_force_ro" ] && echo "$old_force_ro" > "$force_ro" 2>/dev/null || true
        after_md5="$(md5_of_block_prefix "$dev" "$fsz" 2>/dev/null || echo unknown)"
        echo "写入后：分区前 ${fsz} 字节 MD5=$after_md5"
        [ "$after_md5" = "$file_md5" ] || { err "写入后 MD5 不一致，可能写入失败或设备异常，请不要重启并先检查备份。"; exit 6; }
        echo "MD5 校验通过：写入文件与目标分区内容一致。"
        echo "$part 写入完成。写入 bootloader / 分区表后建议重启。"
    else
        mtdnum="$(basename "$dev")"; mtype="$(cat /sys/class/mtd/$mtdnum/type 2>/dev/null || echo unknown)"
        psz="$(cat /sys/class/mtd/$mtdnum/size 2>/dev/null || mtd_size "$part" 2>/dev/null || echo 0)"
        [ "$psz" -gt 0 ] && [ "$fsz" -le "$psz" ] || { err "镜像大于目标 MTD 分区，已取消"; exit 5; }
        # 写入前备份，小分区一般可放入 /tmp
        check_bad_blocks "$dev"
        if command -v nanddump >/dev/null 2>&1 && is_nand_type "$mtype"; then nanddump -f "/tmp/route-tool-${part}-before-write-$$.bin" "$dev" >/dev/null 2>&1 || true; else dd if="$dev" of="/tmp/route-tool-${part}-before-write-$$.bin" bs=64k 2>/dev/null || true; fi
        before_md5="$(md5_of_mtd_prefix "$dev" "$fsz" 2>/dev/null || echo unknown)"
        file_md5="$(md5_of_file "$file" 2>/dev/null || echo unknown)"
        echo "写入前：分区前 ${fsz} 字节 MD5=$before_md5，文件 MD5=$file_md5"
        if is_nand_type "$mtype"; then
            command -v flash_erase >/dev/null 2>&1 || { err "缺少 flash_erase，无法安全写 NAND"; exit 4; }
            command -v nandwrite >/dev/null 2>&1 || { err "缺少 nandwrite，无法安全写 NAND"; exit 4; }
            flash_erase "$dev" 0 0 >/dev/null 2>&1 || { err "NAND 擦除失败"; exit 6; }
            nandwrite -p "$dev" "$file" >/dev/null 2>&1 || { err "NAND 写入失败"; exit 6; }
        else
            if command -v mtd >/dev/null 2>&1; then
                mtd write "$file" "$mtdnum" >/dev/null 2>&1 || mtd write "$file" "$part" >/dev/null 2>&1 || { err "MTD 写入失败"; exit 6; }
            else
                command -v flash_erase >/dev/null 2>&1 || { err "缺少 mtd/flash_erase，无法写入"; exit 4; }
                flash_erase "$dev" 0 0 >/dev/null 2>&1 || { err "MTD 擦除失败"; exit 6; }
                dd if="$file" of="$dev" bs=64k 2>/dev/null || { err "MTD 写入失败"; exit 6; }
            fi
        fi
        sync
        after_md5="$(md5_of_mtd_prefix "$dev" "$fsz" 2>/dev/null || echo unknown)"
        echo "写入后：分区前 ${fsz} 字节 MD5=$after_md5"
        if [ "$after_md5" = "$file_md5" ]; then
            echo "MD5 校验通过：写入文件与目标分区内容一致。"
        else
            if is_nand_type "$mtype"; then
                err "写入后 MD5 不一致。NAND 若存在坏块/跳块/OOB 差异可能导致校验不一致，也可能写入异常；请结合坏块数量和备份谨慎判断。"
            else
                err "写入后 MD5 不一致，可能写入失败或设备异常，请不要重启并先检查备份。"
            fi
            exit 6
        fi
        echo "$part 写入完成。写入 bootloader / 分区表后建议重启。"
    fi
}

# Make sure sgdisk is available (installs gdisk on demand).
ensure_sgdisk(){
    command -v sgdisk >/dev/null 2>&1 && return 0
    echo "正在从系统仓库安装 sgdisk..."
    if command -v apk >/dev/null 2>&1; then
        apk update >/dev/null 2>&1 || true
        apk add gdisk >/dev/null 2>&1 || apk add --allow-untrusted gdisk >/dev/null 2>&1 || \
        apk add sgdisk >/dev/null 2>&1 || { err "sgdisk 安装失败，请手动安装: apk update && apk add gdisk"; return 1; }
    elif command -v opkg >/dev/null 2>&1; then
        opkg update >/dev/null 2>&1 || { err "opkg update 失败，无法自动安装 gdisk"; return 1; }
        opkg install gdisk >/dev/null 2>&1 || opkg install sgdisk >/dev/null 2>&1 || { err "gdisk 安装失败，请手动安装: opkg install gdisk"; return 1; }
    else
        err "未找到包管理器(apk/opkg)，请手动安装 gdisk"; return 1
    fi
    echo "sgdisk 安装完成。"
    # Re-hash PATH so newly installed binaries are found
    hash -r 2>/dev/null || true
    export PATH="/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
    command -v sgdisk >/dev/null 2>&1 || { err "sgdisk 仍不可用，请手动安装 gdisk 后重试"; return 1; }
    return 0
}

# Create / format / mount the ext4 "storage" partition.
#   $1 = confirm flag ("YES" executes, empty = preview only)
#   $2 = reuse mode ("1" = reuse an existing storage partition, "0" = refuse)
storage_setup(){
    confirm="${1:-}"
    reuse="${2:-0}"
    emmc="$(find_emmc)" || { err "未发现 eMMC 设备"; exit 3; }
    base="$(basename "$emmc")"
    export PATH="/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
    ensure_sgdisk || exit 4

    # An already existing "storage" partition: reuse it (one click flow) or refuse.
    existing="$(rt_disk_find_label "$emmc" "$RT_STORAGE_LABEL")"
    if [ -n "$existing" ]; then
        ex_dev="$(printf '%s' "$existing" | cut -d'|' -f1)"
        ex_size="$(printf '%s' "$existing" | cut -d'|' -f5)"
        ex_mnt="$(awk -v d="$ex_dev" '$1 == d { print $2; exit }' /proc/mounts 2>/dev/null)"
        ex_type="$(blkid -s TYPE -o value "$ex_dev" 2>/dev/null)"
        if [ "$reuse" != "1" ]; then
            err "已存在名为 storage 的分区：$ex_dev（可在 Swap 管理里用「一键 Swap + ext4」复用它）"; exit 6
        fi
        if [ "$confirm" != "YES" ]; then
            printf "已存在名为 storage 的分区：\n"
            printf "  设备: %s\n" "$ex_dev"
            printf "  大小: %sMB\n" "$ex_size"
            printf "  文件系统: %s\n" "${ex_type:-未知}"
            printf "  挂载点: %s\n" "${ex_mnt:-未挂载}"
            exit 0
        fi
        lock_begin
        if [ -n "$ex_mnt" ]; then
            echo "分区已挂载，先卸载..."
            umount "$ex_dev" 2>/dev/null || true
        fi
        if [ "$ex_type" != "ext4" ]; then
            if [ -n "$ex_type" ]; then
                echo "⚠️ $ex_dev 上已有 ${ex_type} 文件系统，将被覆盖为 ext4（原数据丢失）"
            fi
            echo "正在格式化 $ex_dev 为 ext4..."
            mkfs.ext4 -U "$RT_STORAGE_UUID" -L "$RT_STORAGE_LABEL" "$ex_dev" >/dev/null 2>&1 || { err "ext4 格式化失败"; exit 8; }
        fi
        mnt="/mnt/$(basename "$ex_dev")"
        mkdir -p "$mnt"
        mount "$ex_dev" "$mnt" 2>/dev/null || { err "挂载失败，分区已格式化。请手动: mount $ex_dev $mnt"; exit 9; }
        rt_fstab_enable_mount "$ex_dev" "$RT_STORAGE_UUID" "$RT_STORAGE_LABEL" "$mnt"
        echo "✅ eMMC 存储分区已就绪"
        echo "  设备: $ex_dev"
        echo "  挂载: $mnt"
        echo "  大小: ${ex_size}MB"
        echo "  UUID: $RT_STORAGE_UUID"
        echo "  文件系统: ext4"
        echo "  已写入 /etc/config/fstab（重启后自动挂载）"
        return 0
    fi

    rt_gpt_scan "$emmc" || { err "无法读取 eMMC 分区表（sgdisk 与 /sys 都没有分区信息）"; exit 5; }
    next_start="$RT_GPT_NEXT_START"
    disk_end="$RT_GPT_DISK_END"
    free_sectors="$RT_GPT_FREE_SECTORS"
    free_mb="$RT_GPT_FREE_MB"

    if [ "$free_sectors" -lt 2048 ]; then
        err "eMMC 无可用未分配空间（剩余 ${free_mb}MB，最小需要 1MB）"
        exit 5
    fi

    next_pnum="$(rt_gpt_next_pnum "$emmc")"

    if [ "$confirm" != "YES" ]; then
        # Dry-run / preview mode
        warn=""
        reserve_note=""
        if [ "$free_mb" -lt 500 ]; then
            warn="⚠️ 可用空间仅 ${free_mb}MB，可能是厂商预留的未使用空间，新建分区可能影响系统稳定性。"
        fi
        if [ "$((free_sectors - RT_RESERVE_SECTORS))" -gt 4096 ] 2>/dev/null; then
            reserve_note="（尾部预留4MB）"
        fi
        printf "将在 %s 上新建分区：\n" "$emmc"
        printf "  起始扇区: %s (对齐 1MB)\n" "$next_start"
        printf "  结束扇区: %s\n" "$disk_end"
        printf "  大小: %s MB%s\n" "$free_mb" "$reserve_note"
        printf "  分区名: storage (p%d)\n" "$next_pnum"
        printf "  文件系统: ext4\n"
        printf "  UUID: %s\n" "$RT_STORAGE_UUID"
        printf "  挂载点: /mnt/%sp%d\n" "$base" "$next_pnum"
        [ -n "$warn" ] && printf "\n%s\n" "$warn"
        exit 0
    fi

    lock_begin

    rt_gpt_verify "$emmc" || exit 6

    # Cross-validate the free space with sgdisk (it knows the real GPT limits).
    sgdisk_end="$(sgdisk -E "$emmc" 2>/dev/null)" || sgdisk_end=""
    sgdisk_first="$(sgdisk -F "$emmc" 2>/dev/null)" || sgdisk_first=""
    if [ -n "$sgdisk_end" ] && [ "$sgdisk_end" -gt 0 ] 2>/dev/null; then
        if [ "$sgdisk_end" -ne "$disk_end" ] 2>/dev/null; then
            echo "⚠️ 空闲空间结束扇区校正: $disk_end → $sgdisk_end (GPT last usable)"
            disk_end="$sgdisk_end"
            free_sectors=$((disk_end - next_start + 1))
            free_mb=$((free_sectors * 512 / 1024 / 1024))
        fi
        if [ -n "$sgdisk_first" ] && [ "$sgdisk_first" -gt 0 ] 2>/dev/null; then
            if [ "$sgdisk_first" -ne "$next_start" ] 2>/dev/null; then
                echo "⚠️ 起始扇区校正: $next_start → $sgdisk_first (sgdisk 对齐)"
                next_start="$sgdisk_first"
                free_sectors=$((disk_end - next_start + 1))
                free_mb=$((free_sectors * 512 / 1024 / 1024))
            fi
        fi
    fi

    if [ "$free_sectors" -lt 2048 ]; then
        err "eMMC 无可用未分配空间（校正后剩余 ${free_mb}MB）"
        exit 5
    fi

    # Keep 4MB at the end of the disk for the GPT backup header.
    new_end=0
    if [ "$free_sectors" -gt $((RT_RESERVE_SECTORS + 4096)) ] && [ "$next_start" -lt $((disk_end - RT_RESERVE_SECTORS)) ]; then
        new_end=$((disk_end - RT_RESERVE_SECTORS))
        echo "ℹ️ 尾部预留 ${RT_RESERVE_SECTORS}扇区(4MB), 分区结束于 $new_end (磁盘尾 $disk_end)"
    fi

    echo "正在新建分区 (p${next_pnum})..."
    rt_gpt_create "$emmc" "$next_pnum" "$next_start" "$new_end" "$RT_STORAGE_LABEL" 8300 || exit 6

    new_part="$(rt_gpt_wait_dev "$base" "$next_pnum" "$RT_STORAGE_LABEL")" || {
        err "新建分区设备未出现，可能需要重启。GPT 已修改。"
        exit 7
    }

    echo "正在格式化 $new_part 为 ext4..."
    mkfs.ext4 -U "$RT_STORAGE_UUID" -L "$RT_STORAGE_LABEL" "$new_part" >/dev/null 2>&1 || { err "ext4 格式化失败"; exit 8; }

    mnt="/mnt/$(basename "$new_part")"
    echo "正在挂载 $new_part -> $mnt ..."
    mkdir -p "$mnt"
    mount "$new_part" "$mnt" 2>/dev/null || { err "挂载失败，分区已创建并格式化。请手动: mount $new_part $mnt"; exit 9; }

    rt_fstab_enable_mount "$new_part" "$RT_STORAGE_UUID" "$RT_STORAGE_LABEL" "$mnt"

    echo "✅ eMMC 存储分区创建完成"
    echo "  设备: $new_part"
    echo "  挂载: $mnt"
    echo "  大小: ${free_mb}MB"
    echo "  UUID: $RT_STORAGE_UUID"
    echo "  文件系统: ext4"
    echo "  已写入 /etc/config/fstab（重启后自动挂载）"
}

# Allocate unpartitioned eMMC space as a new "storage" partition (ext4, auto-mount)
alloc_storage(){
    storage_setup "${1:-}" 0
}

# ── swap ──────────────────────────────────────────────────────────────────────

# Collect the swap state into globals:
#   SWAP_MEM SWAP_SUG SWAP_SIZE SWAP_PART SWAP_DEV SWAP_LABEL SWAP_PSIZE
#   SWAP_STATE SWAP_ACTIVE
swap_collect(){
    mode="${1:-auto}"; want="${2:-0}"
    SWAP_MEM="$(rt_mem_total_mb)"
    SWAP_SUG="$(rt_swap_suggest_mb "$SWAP_MEM")"
    SWAP_SIZE="$(rt_swap_resolve_size "$mode" "$want" "$SWAP_SUG")"
    SWAP_PART=""
    SWAP_DEV=""
    SWAP_LABEL=""
    SWAP_PSIZE=0
    SWAP_STATE=""
    SWAP_ACTIVE=0
    emmc="$(find_emmc 2>/dev/null || true)"
    [ -n "$emmc" ] || return 0
    part="$(rt_swap_find_part "$emmc")"
    [ -n "$part" ] || return 0
    SWAP_PART="$part"
    SWAP_DEV="$(printf '%s' "$part" | cut -d'|' -f1)"
    SWAP_LABEL="$(printf '%s' "$part" | cut -d'|' -f2)"
    SWAP_PSIZE="$(printf '%s' "$part" | cut -d'|' -f4)"
    SWAP_STATE="$(rt_swap_state "$SWAP_DEV")"
    rt_swap_is_active "$SWAP_DEV" && SWAP_ACTIVE=1
    return 0
}

# Human readable swap state.
swap_state_text(){
    case "$1" in
        swap) echo "已格式化" ;;
        blank) echo "未格式化" ;;
        missing) echo "设备不存在" ;;
        foreign:*) echo "已有其它文件系统(${1#foreign:})" ;;
        *) echo "${1:-未知}" ;;
    esac
}

# Print the swap plan (no changes).
swap_cmd_plan(){
    mode="${1:-auto}"; want="${2:-0}"; with_ext4="${3:-0}"
    swap_collect "$mode" "$want"
    emmc="$(find_emmc 2>/dev/null || true)"

    printf "📋 Swap 规划（磁盘：%s）\n" "${emmc:-未发现 eMMC}"
    printf "  物理内存: %sMB（当前可用 %sMB）\n" "$SWAP_MEM" "$(rt_mem_available_mb)"
    printf "  %s\n" "$(rt_swap_advice "$SWAP_MEM" "$SWAP_SUG")"
    printf "  最低可建容量: %sMB\n" "$RT_SWAP_MIN_MB"
    printf "  目标容量: %s\n" "$([ "$SWAP_SIZE" -gt 0 ] && echo "${SWAP_SIZE}MB" || echo "不创建")"

    if [ -n "$SWAP_DEV" ]; then
        printf "  已存在 swap 分区: %s" "$SWAP_DEV"
        [ -n "$SWAP_LABEL" ] && printf "（%s）" "$SWAP_LABEL"
        printf "\n"
        printf "    容量: %sMB   状态: %s   已启用: %s\n" "$SWAP_PSIZE" "$(swap_state_text "$SWAP_STATE")" "$([ "$SWAP_ACTIVE" = 1 ] && echo 是 || echo 否)"
        case "$SWAP_STATE" in
            swap)
                printf "    → 已格式化，直接启用并写入 fstab\n" ;;
            blank)
                if [ "$SWAP_SIZE" -gt 0 ] && [ "$SWAP_SIZE" -ne "$SWAP_PSIZE" ]; then
                    printf "    → 未格式化，将重建为 %sMB 后启用\n" "$SWAP_SIZE"
                else
                    printf "    → 未格式化，将执行 mkswap 后启用\n"
                fi ;;
            *)
                printf "    → 不会自动覆盖已有数据\n" ;;
        esac
    else
        printf "  未发现 GPT 内的 swap 分区\n"
        if [ "$SWAP_SIZE" -gt 0 ]; then
            printf "    → 将在尾部空闲区新建 %sMB swap 分区\n" "$SWAP_SIZE"
        else
            printf "    → 内存充足，不建议新建；如需强制创建请选择「最低」或「自定义」\n"
        fi
    fi

    if [ "$with_ext4" = "1" ]; then
        printf "  ext4 存储分区: %s\n" "$(storage_plan_text "$emmc")"
    fi
    return 0
}

# Short description of the ext4 storage partition state.
storage_plan_text(){
    emmc="$1"
    part="$(rt_disk_find_label "$emmc" "$RT_STORAGE_LABEL" 2>/dev/null)"
    if [ -n "$part" ]; then
        dev="$(printf '%s' "$part" | cut -d'|' -f1)"
        size="$(printf '%s' "$part" | cut -d'|' -f5)"
        type="$(blkid -s TYPE -o value "$dev" 2>/dev/null)"
        mnt="$(awk -v d="$dev" '$1 == d { print $2; exit }' /proc/mounts 2>/dev/null)"
        printf "已存在 %s（%sMB, %s, 挂载 %s），将确保格式化并挂载" "$dev" "$size" "${type:-无文件系统}" "${mnt:-未挂载}"
        return 0
    fi
    if rt_gpt_scan "$emmc" >/dev/null 2>&1; then
        printf "将在尾部空闲区新建（剩余 %sMB）" "$RT_GPT_FREE_MB"
    else
        printf "无法读取 eMMC 空闲空间"
    fi
}

# Create a new swap partition of the given size (MB) in the free tail area.
swap_create_new(){
    emmc="$1"; base="$2"; size_mb="$3"
    rt_gpt_scan "$emmc" || { err "无法读取 eMMC 分区表"; exit 5; }
    sectors=$(( size_mb * 1024 * 1024 / 512 ))
    [ "$sectors" -gt 0 ] || { err "swap 容量无效"; exit 2; }
    if [ "$RT_GPT_FREE_SECTORS" -lt $(( sectors + RT_RESERVE_SECTORS + 2048 )) ]; then
        err "尾部空闲空间不足（剩余 ${RT_GPT_FREE_MB}MB，需要约 $((size_mb + 6))MB）"
        exit 5
    fi
    start="$RT_GPT_NEXT_START"
    end=$(( start + sectors - 1 ))
    pnum="$(rt_gpt_next_pnum "$emmc")"
    rt_gpt_verify "$emmc" || exit 6
    echo "正在新建 swap 分区 (p${pnum}, ${size_mb}MB)..."
    rt_gpt_create "$emmc" "$pnum" "$start" "$end" "$RT_SWAP_LABEL" 8200 || exit 6
    dev="$(rt_gpt_wait_dev "$base" "$pnum" "$RT_SWAP_LABEL")" || { err "新建分区设备未出现，可能需要重启。GPT 已修改。"; exit 7; }
    echo "正在格式化 $dev 为 swap ..."
    rt_swap_format "$dev" "$RT_SWAP_LABEL" || { err "mkswap 失败"; exit 8; }
    echo "正在启用 swap 分区 $dev ..."
    rt_swap_enable "$dev" "$RT_SWAP_PRIO" || { err "启用 swap 失败：$dev"; exit 9; }
    rt_fstab_enable_swap "$dev" "$RT_SWAP_LABEL" "$RT_SWAP_PRIO"
    echo "✅ swap 分区创建完成"
    echo "  设备: $dev"
    echo "  容量: ${size_mb}MB"
    echo "  优先级: $RT_SWAP_PRIO"
    echo "  已写入 /etc/config/fstab（重启后自动启用）"
    SWAP_DEV="$dev"
    SWAP_LABEL="$RT_SWAP_LABEL"
    return 0
}

# Delete the current swap partition and create a new one with the given size.
swap_rebuild(){
    emmc="$1"; base="$2"; size_mb="$3"
    pnum="$(rt_part_num "$SWAP_DEV")"
    rt_swap_disable "$SWAP_DEV" 2>/dev/null || true
    echo "正在删除旧 swap 分区 (p${pnum}) ..."
    rt_gpt_delete "$emmc" "$pnum" || exit 6
    partprobe "/dev/$base" 2>/dev/null || blockdev --rereadpt "/dev/$base" 2>/dev/null || true
    sleep 1
    swap_create_new "$emmc" "$base" "$size_mb"
}

# Make sure a swap partition exists, is formatted and active.
#   $1 = mode (auto|min|custom)  $2 = size_mb  $3 = confirm (YES)
swap_cmd_create(){
    mode="${1:-auto}"; want="${2:-0}"; with_ext4="${3:-0}"; confirm="${4:-}"
    swap_collect "$mode" "$want"

    emmc="$(find_emmc 2>/dev/null || true)"
    [ -n "$emmc" ] || { err "未发现 eMMC 设备，无法创建 swap 分区"; exit 3; }
    base="$(basename "$emmc")"

    if [ "$confirm" != "YES" ]; then
        swap_cmd_plan "$mode" "$want" "$with_ext4"
        exit 0
    fi

    ensure_sgdisk || exit 4
    lock_begin

    if [ -n "$SWAP_DEV" ]; then
        case "$SWAP_STATE" in
            swap)
                if [ "$SWAP_ACTIVE" = 1 ]; then
                    echo "swap 分区 $SWAP_DEV 已启用，跳过格式化"
                else
                    echo "正在启用 swap 分区 $SWAP_DEV ..."
                    rt_swap_enable "$SWAP_DEV" "$RT_SWAP_PRIO" || { err "启用 swap 失败：$SWAP_DEV"; exit 6; }
                fi
                rt_fstab_enable_swap "$SWAP_DEV" "$SWAP_LABEL" "$RT_SWAP_PRIO"
                ;;
            blank|missing)
                if [ "$SWAP_SIZE" -gt 0 ] && [ "$SWAP_SIZE" -ne "$SWAP_PSIZE" ]; then
                    echo "swap 分区 $SWAP_DEV 未格式化（${SWAP_PSIZE}MB），按目标 ${SWAP_SIZE}MB 重建..."
                    swap_rebuild "$emmc" "$base" "$SWAP_SIZE" || exit 6
                else
                    echo "正在格式化 $SWAP_DEV 为 swap ..."
                    rt_swap_format "$SWAP_DEV" "$SWAP_LABEL" || { err "mkswap 失败"; exit 6; }
                    echo "正在启用 swap 分区 $SWAP_DEV ..."
                    rt_swap_enable "$SWAP_DEV" "$RT_SWAP_PRIO" || { err "启用 swap 失败"; exit 6; }
                    rt_fstab_enable_swap "$SWAP_DEV" "$SWAP_LABEL" "$RT_SWAP_PRIO"
                fi
                ;;
            *)
                err "$SWAP_DEV 上已有其它文件系统（${SWAP_STATE#foreign:}），拒绝覆盖"
                exit 6
                ;;
        esac
        SWAP_STATE="$(rt_swap_state "$SWAP_DEV")"
        echo "✅ swap 就绪：$SWAP_DEV（$(swap_state_text "$SWAP_STATE")）"
    else
        [ "$SWAP_SIZE" -gt 0 ] || { err "内存 ${SWAP_MEM}MB，按建议不需要 swap；如需强制创建请用「最低」或「自定义」容量"; exit 5; }
        swap_create_new "$emmc" "$base" "$SWAP_SIZE" || exit 6
    fi

    if [ "$with_ext4" = "1" ]; then
        echo "---"
        storage_setup "YES" 1
    fi

    echo "---"
    echo "当前 swap 状态："
    swapon -s 2>/dev/null || cat /proc/swaps 2>/dev/null
    return 0
}

# Disable the swap partition (keep the partition and its data).
swap_cmd_disable(){
    confirm="${1:-}"
    swap_collect auto 0
    [ -n "$SWAP_DEV" ] || { echo "未发现 swap 分区，无需关闭"; exit 0; }
    if [ "$confirm" != "YES" ]; then
        printf "将停用 swap 分区：%s（分区保留）\n" "$SWAP_DEV"
        exit 0
    fi
    lock_begin
    if rt_swap_disable "$SWAP_DEV"; then
        echo "已关闭 swap：$SWAP_DEV"
    else
        echo "关闭 swap 失败：$SWAP_DEV"
    fi
    rt_fstab_disable_swap "$SWAP_DEV"
    echo "已更新 /etc/config/fstab（重启后不再启用）"
}

# Delete the swap partition (including its GPT entry).
swap_cmd_delete(){
    confirm="${1:-}"
    swap_collect auto 0
    [ -n "$SWAP_DEV" ] || { echo "未发现 swap 分区"; exit 0; }
    if [ "$confirm" != "YES" ]; then
        printf "将删除 swap 分区：%s（不可恢复）\n" "$SWAP_DEV"
        exit 0
    fi
    emmc="$(find_emmc)" || { err "未发现 eMMC 设备"; exit 3; }
    base="$(basename "$emmc")"
    ensure_sgdisk || exit 4
    lock_begin
    rt_swap_disable "$SWAP_DEV" 2>/dev/null || true
    pnum="$(rt_part_num "$SWAP_DEV")"
    rt_gpt_delete "$emmc" "$pnum" || exit 6
    partprobe "/dev/$emmc" 2>/dev/null || blockdev --rereadpt "/dev/$emmc" 2>/dev/null || true
    rt_fstab_disable_swap "$SWAP_DEV"
    echo "✅ 已删除 swap 分区 p${pnum}（${SWAP_DEV}）"
}

# JSON status of the swap setup.
swap_cmd_info(){
    emmc="$(find_emmc 2>/dev/null || true)"
    rt_swap_info_json "$emmc"
}

cmd="${1:-list}"
case "$cmd" in
    list) list_json ;;
    backup) [ -n "${2:-}" ] || { err "缺少分区名"; exit 2; }; backup_part "$2" ;;
    write) [ -n "${2:-}" ] && [ -n "${3:-}" ] || { err "用法：route-tool write 分区 文件 YES"; exit 2; }; write_part "$2" "$3" "${4:-}" ;;
    alloc_storage) alloc_storage "${2:-}" ;;
    swap_info) swap_cmd_info ;;
    swap_plan) swap_cmd_plan "${2:-auto}" "${3:-0}" "${4:-0}" ;;
    swap_create) swap_cmd_create "${2:-auto}" "${3:-0}" "${4:-0}" "${5:-}" ;;
    swap_disable) swap_cmd_disable "${2:-}" ;;
    swap_delete) swap_cmd_delete "${2:-}" ;;
    *) err "未知命令：$cmd"; exit 2 ;;
esac
