#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# luci-app-pon-info: 周期性把 PON 状态写入 /etc/poninfo/history.jsonl

START=95
USE_PROCD=1
PROG=/usr/libexec/pon-info-recorder

start_service() {
	config_load poninfo
	config_get_bool enabled settings enabled 1
	[ "$enabled" = 1 ] || return 0

	config_get interval settings interval 60
	case "$interval" in
		''|*[!0-9]*) interval=60 ;;
	esac
	[ "$interval" -ge 5 ] || interval=5

	mkdir -p /etc/poninfo
	procd_open_instance
	procd_set_param command "$PROG" "$interval"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
