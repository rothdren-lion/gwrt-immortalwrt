#!/bin/sh
# GWRT-Agent — v1712-r9 shell reporting / mesh control adapter
#
# 背景: 原 1712 预编译二进制与 op.gwrt.uk 服务端契约错配, 导致上报全失败:
#   1. 认证: 原版用 X-GWRT-Token: <local_token>  -> 服务端要 Authorization: Bearer <pair_token>
#   2. 毒药字段: body 带 "hardware_id" -> 服务端 handler 直接 500 (实测 3/3 复现)
#   3. local_token 服务端从不发放 (register 返回 local_token_command_id:null)
# 本脚本按实测契约重写上报链路; 遥测采集仍复用原二进制 (gwrt-agent.bin) 的 dump。
#
# 实测契约 (2026-10-04, op.gwrt.uk):
#   POST /api/agent/register  Bearer pair_token  {device_id,...}            -> ok
#   POST /api/agent/report    Bearer pair_token  {遥测, 无 hardware_id}      -> ok
#   POST /api/agent/pull      Bearer pair_token  {device_id}                 -> {commands:[]}
#   POST /api/agent/heartbeat Bearer pair_token  {device_id}                 -> {server_time,report_interval}
#   POST /api/agent/ack       Bearer pair_token  {device_id,command_id,      -> ok
#                                                 status: success|failed}

ORIG="/usr/sbin/gwrt-agent.bin"
CFG="/etc/config/gwrt-agent"
# UA 保持 r8：服务端是否校验 UA 未经验证，不随 shim 版本号一起改。
UA="gwrt-agent/1712-r8"
JSON_HELPER="/usr/share/gwrt-agent/json.uc"
STATE_DIR="/tmp/gwrt-agent"

log() { logger -t gwrt-agent "$@"; }

cfg() { uci -q get "$CFG.main.$1" 2>/dev/null; }

endpoint() {
	local url
	url=$(cfg endpoint)
	printf '%s' "${url:-https://op.gwrt.uk}" | sed 's:/*$::'
}

ipv6_endpoint() {
	[ "$(cfg prefer_ipv6)" != 0 ] || return 1
	local url
	url=$(cfg endpoint_ipv6)
	if [ -z "$url" ]; then
		# Old conffiles get the new route without rewriting identities or UCI.
		# Never send a private server's credentials to the public GWRT service.
		case "$(endpoint)" in
			https://op.gwrt.uk) url='https://op6.gwrt.uk:8443';;
			*) return 1;;
		esac
	fi
	case "$url" in https://*) printf '%s' "$url" | sed 's:/*$::';; *) return 1;; esac
}

ipv6_ready() { ip -6 route show default 2>/dev/null | grep -q '^default'; }

network_ready() {
	ip route 2>/dev/null | grep -q '^default' || ipv6_ready
}

# Command substitution runs api() in a subshell. Keep cooldown/route state in
# tmpfs so the next pull/report/ack shares it; never write it into flash/UCI.
transport_state() {
	local name="$1" value="$2" tmp
	mkdir -p "$STATE_DIR" || return 1
	tmp=$(mktemp "$STATE_DIR/transport.XXXXXX") || return 1
	printf '%s\n' "$value" >"$tmp" && mv -f "$tmp" "$STATE_DIR/$name" && return 0
	rm -f "$tmp"
	return 1
}

transport_connected() {
	local value="$1 $2" previous
	previous=$(cat "$STATE_DIR/connection" 2>/dev/null)
	[ "$previous" = "$value" ] && return 0
	transport_state connection "$value"
	log "transport connected: $value"
}

ipv6_retry_ready() {
	local saved until now
	[ -f "$STATE_DIR/ipv6-retry" ] || return 0
	{ IFS= read -r saved; IFS= read -r until; } <"$STATE_DIR/ipv6-retry"
	[ "$saved" = "$1" ] || return 0
	case "$until" in ''|*[!0-9]*|????????????*) return 0;; esac
	now=$(date +%s)
	# Also recover immediately if an NTP clock correction invalidates the timer.
	[ "$now" -ge "$until" ] || [ "$until" -gt "$((now + 60))" ]
}

# 2026-11-14 修复：服务端对未知 (device_id, pair_token) 一律回 401
#   {"ok":false,"error":"unknown device or token"}
# 旧行为：ensure_device_id 里 do_pair 的输出被丢弃 → 首次注册失败（如开机时
# WAN 未就绪）后没人重试，daemon 每 5-30 秒拿同一枚 token 重发 report/pull，
# 日志刷满 401 且永不自愈。现在：认证失败记入 tmpfs 状态，指数退避
# （60/300/900/1800/3600 秒），退避期内只做一次 POST /api/agent/register，
# 成功即清除状态并恢复上报。
AUTH_STATE="$STATE_DIR/auth"
AUTH_UNTIL=0
AUTH_LEVEL=0
AUTH_REASON=""

auth_read() {
	local until level reason
	AUTH_UNTIL=0 AUTH_LEVEL=0 AUTH_REASON=""
	[ -f "$AUTH_STATE" ] || return 0
	{ IFS= read -r until; IFS= read -r level; IFS= read -r reason; } <"$AUTH_STATE" 2>/dev/null
	case "$until" in ''|*[!0-9]*) return 0;; esac
	AUTH_UNTIL="$until"
	case "$level" in ''|*[!0-9]*) level=1;; esac
	AUTH_LEVEL="$level"
	AUTH_REASON="$reason"
	return 0
}

auth_blocked() { auth_read; [ "$AUTH_UNTIL" -gt "$(date +%s)" ]; }

auth_due() { auth_read; [ "$AUTH_UNTIL" -gt 0 ] && [ "$AUTH_UNTIL" -le "$(date +%s)" ]; }

# Remaining backoff, bounded so a new route/identity is re-checked regularly.
auth_wait() {
	auth_read
	local left=$((AUTH_UNTIL - $(date +%s)))
	[ "$left" -gt 0 ] || left=5
	[ "$left" -gt 300 ] && left=300
	echo "$left"
}

# Keep the backoff without escalating or logging (failed re-register attempt).
auth_postpone() {
	auth_read
	[ "$AUTH_UNTIL" -gt 0 ] || return 0
	transport_state auth "$(printf '%s\n%s\n%s' "$(( $(date +%s) + $1 ))" "$AUTH_LEVEL" "$AUTH_REASON")"
}

# Backoff step for the current escalation level (seconds).
auth_delay() {
	auth_read
	case "$AUTH_LEVEL" in
	1) echo 60;; 2) echo 300;; 3) echo 900;; 4) echo 1800;; *) echo 3600;;
	esac
}

# $1 = short log-safe reason (redacted: no tokens, only path/status)
auth_fail() {
	auth_read
	local level=$((AUTH_LEVEL + 1)) delay reason="$1"
	case "$level" in
	1) delay=60;; 2) delay=300;; 3) delay=900;; 4) delay=1800;; *) delay=3600;;
	esac
	[ -n "$reason" ] || reason="$AUTH_REASON"
	transport_state auth "$(printf '%s\n%s\n%s' "$(( $(date +%s) + delay ))" "$level" "$reason")"
	log "cloud rejected device credentials ($reason); auto re-register in ${delay}s (attempt $level). If this repeats the server has no binding for this device"
}

auth_ok() {
	[ -f "$AUTH_STATE" ] || return 0
	rm -f "$AUTH_STATE"
	log "cloud credentials accepted; reporting resumed"
}

# 0 = identity rejection (retrying cannot help), not a transport problem.
auth_failure() {
	case "$1" in
	'__API_FAIL__ http 401'*|'__API_FAIL__ http 403'*) return 0;;
	esac
	case "$1" in *'unknown device or token'*) return 0;; esac
	return 1
}

# Same message twice in a row must not fill the ring buffer.
log_once() { # $1=key $2=message
	local prev
	prev=$(cat "$STATE_DIR/once-$1" 2>/dev/null)
	[ "$prev" = "$2" ] && return 0
	transport_state "once-$1" "$2"
	log "$2"
}

# One attempt: 0=valid API JSON, 1=transport/upstream failure, 2=HTTP rejection.
# Never follow redirects with the device's bearer token or disable TLS checks.
api_request() {
	local path="$1" body="$2" url="$3" family="$4" dir code rc ok why connect=3 total=15
	mkdir -p "$STATE_DIR" || { echo '__API_FAIL__ state directory'; return 1; }
	dir=$(mktemp -d "$STATE_DIR/http.XXXXXX") || { echo '__API_FAIL__ temporary file'; return 1; }
	set --
	if [ "$family" = ipv6 ]; then set -- -6; connect=2; total=4; fi
	code=$(curl "$@" -sS --connect-timeout "$connect" -m "$total" --noproxy '*' \
		-o "$dir/body" -w '%{http_code}' \
		-H "Content-Type: application/json" \
		-H "User-Agent: $UA" \
		-H "Authorization: Bearer $(cfg pair_token)" \
		-d "$body" \
		"${url}${path}" 2>"$dir/error")
	rc=$?
	if [ "$rc" -ne 0 ]; then
		case "$rc" in
			6) why="dns" ;;
			7) why="connect" ;;
			28) why="timeout" ;;
			35|60) why="tls" ;;
			52) why="empty-reply" ;;
			56) why="recv" ;;
			*) why="curl-rc$rc" ;;
		esac
		[ -s "$dir/error" ] && why="$why: $(tr -d '\n' <"$dir/error" | cut -c1-120)"
		printf '__API_FAIL__ %s (endpoint=%s%s)' "$why" "$url" "$path"
		rm -rf "$dir"
		return 1
	fi
	rc=1
	case "$code" in
		2??)
			ok=$(jsonfilter -i "$dir/body" -e '@.ok' 2>/dev/null)
			case "$ok" in
				true|false) cat "$dir/body"; rc=0;;
				*) printf '__API_FAIL__ invalid API JSON (endpoint=%s%s)' "$url" "$path";;
			esac;;
		*)
			printf '__API_FAIL__ http %s (endpoint=%s%s)' "$code" "$url" "$path"
			case "$code" in 408|425|429) ;; 4??) rc=2;; esac;;
	esac
	rm -rf "$dir"
	return "$rc"
}

# api <path> <json-body>: IPv6 direct first, original endpoint as fallback.
# Sequential requests preserve the server's existing command delivery/ACK flow.
api() {
	local path="$1" body="$2" direct fallback rsp rc
	fallback=$(endpoint)
	direct=$(ipv6_endpoint)
	if [ -n "$direct" ] && ipv6_ready && ipv6_retry_ready "$direct"; then
		rsp=$(api_request "$path" "$body" "$direct" ipv6)
		rc=$?
		if [ "$rc" = 0 ]; then
			rm -f "$STATE_DIR/ipv6-retry"
			transport_connected ipv6 "$direct"
			auth_ok
			printf '%s' "$rsp"
			return 0
		fi
		# Authentication/validation errors must not be retried on another route,
		# and a rejected token is rejected on every route: back off, do not spam.
		if [ "$rc" = 2 ]; then
			auth_failure "$rsp" && auth_fail "$(printf '%s' "$rsp" | cut -c1-90)"
			printf '%s' "$rsp"
			return 1
		fi
		transport_state ipv6-retry "$(printf '%s\n%s' "$direct" "$(($(date +%s) + 60))")"
		log "IPv6 direct unavailable; retry in 60s, falling back: $rsp"
	fi
	rsp=$(api_request "$path" "$body" "$fallback" auto)
	rc=$?
	if [ "$rc" = 0 ]; then
		transport_connected fallback "$fallback"
		auth_ok
	else
		auth_failure "$rsp" && auth_fail "$(printf '%s' "$rsp" | cut -c1-90)"
	fi
	printf '%s' "$rsp"
	[ "$rc" = 0 ]
}

did() { cfg device_id; }

# build report payload: reuse orig dump, strip the poison field
#
# 2026-10-22 (Nokia Beacon 10 / 2402b): 本机 netifd 的 ubus 方法不响应
#   (ubus call network.device status 直接 Request timed out)，
#   C 二进制的 dump 会永久卡在 ubus call 上 -> shim 拿到空 body -> 上报 400。
#   这里给 dump 加超时保护，并在拿不到遥测时退回一个最小合法载荷。
payload() {
	local _tmp _pid _i=0
	mkdir -p /tmp/gwrt-agent
	_tmp=$(mktemp /tmp/gwrt-agent/dump.XXXXXX) || return 1
	if [ -x "$ORIG" ]; then
		( "$ORIG" dump >"$_tmp" 2>/dev/null ) &
		_pid=$!
		while [ $_i -lt 8 ] && kill -0 "$_pid" 2>/dev/null; do sleep 1; _i=$((_i+1)); done
		if kill -0 "$_pid" 2>/dev/null; then
			kill -9 "$_pid" 2>/dev/null; wait "$_pid" 2>/dev/null
			: >"$_tmp"
		else
			wait "$_pid" 2>/dev/null
		fi
	fi
	mesh_report >"$_tmp.mesh" || { rm -f "$_tmp" "$_tmp.mesh"; return 1; }
	ucode "$JSON_HELPER" payload "$_tmp" "$(did)" "$(uname -m)" \
		"$(. /etc/openwrt_release 2>/dev/null; echo "$DISTRIB_DESCRIPTION")" "@$_tmp.mesh"
	local rc=$?
	rm -f "$_tmp" "$_tmp.mesh"
	return "$rc"
}

jstr() { ucode "$JSON_HELPER" quote "$1"; }

mesh_report() {
	local dir apmode=0 rc
	mkdir -p /tmp/gwrt-agent
	dir=$(mktemp -d /tmp/gwrt-agent/mesh.XXXXXX) || return 1
	ubus -t 3 call wifiroam status >"$dir/status" 2>/dev/null
	[ -s "$dir/status" ] || { rm -rf "$dir"; printf '{"available":false}'; return; }
	[ -f /etc/gwrt-apmode.state ] && apmode=1
	ubus -t 3 call wifiroam discover >"$dir/discover" 2>/dev/null
	ubus -t 3 call wifiroam topology >"$dir/topology" 2>/dev/null
	ucode "$JSON_HELPER" mesh "@$dir/status" "@$dir/discover" "@$dir/topology" "$apmode"
	rc=$?
	rm -rf "$dir"
	return "$rc"
}

# read report_interval from a response (fallback: uci config, default 30, floor 5)
interval_of() {
	local n
	n=$(printf '%s' "$1" | jsonfilter -e '@.report_interval' 2>/dev/null)
	case "$n" in ''|*[!0-9]*|????????*) n=$(cfg report_interval);; esac
	case "$n" in ''|*[!0-9]*|????????*) n=30;; esac
	# Both server and local settings must be bounded; invalid UCI must never spin.
	[ "$n" -lt 5 ] && n=5
	[ "$n" -gt 3600 ] && n=3600
	echo "$n"
}

do_report() {
	local rsp body
	body=$(payload) || { log 'report FAILED: telemetry serialization'; return 1; }
	rsp=$(api /api/agent/report "$body")
	# A server-side identity error must not silently discard an existing binding.
	if [ "$(jsonfilter -s "$rsp" -e '@.ok' 2>/dev/null)" = true ]; then
		rm -f "$STATE_DIR/once-report"
		log "report ok: interval=$(interval_of "$rsp")"
	else
		# api() already logged the actionable 401/403 backoff line.
		auth_failure "$rsp" || log_once report "report FAILED: $rsp"
	fi
	printf '%s\n' "$rsp"
}

do_pull() { api /api/agent/pull "{\"device_id\":\"$(jstr "$(did)")\"}"; }

do_ack() { # $1=command_id  $2=status  $3=optional native result
	[ -n "$1" ] || return 0
	local result=""
	[ "$#" -ge 3 ] && result=",\"result\":\"$(jstr "$3")\""
	api /api/agent/ack "{\"device_id\":\"$(jstr "$(did)")\",\"command_id\":\"$(jstr "$1")\",\"status\":\"$2\"$result}"
}

do_heartbeat() { api /api/agent/heartbeat "{\"device_id\":\"$(did)\"}"; }

command_value() {
	local value path
	for path in "@.$2" "@.payload.$2" "@.params.$2" "@.data.$2"; do
		value=$(jsonfilter -s "$1" -e "$path" 2>/dev/null)
		[ -n "$value" ] && { printf '%s' "$value"; return 0; }
	done
	return 1
}

mesh_rpc() {
	local result body="$2"
	[ -n "$body" ] || body='{}'
	result=$(ubus -t 5 call wifiroam "$1" "$body" 2>/dev/null) || return 1
	[ "$(jsonfilter -s "$result" -e '@.ok' 2>/dev/null)" = true ]
}

valid_mac() {
	[ "${#1}" = 17 ] || return 1
	case "$1" in *[!0-9a-fA-F:]*) return 1;; esac
	printf '%s\n' "$1" | grep -Eq '^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$'
}

mesh_member() {
	local file joined
	mkdir -p /tmp/gwrt-agent
	file=$(mktemp /tmp/gwrt-agent/member.XXXXXX) || return 1
	ubus -t 3 call wifiroam topology >"$file" 2>/dev/null
	joined=$(ucode "$JSON_HELPER" member "@$file" "$1")
	rm -f "$file"
	[ "$joined" = 1 ]
}

mesh_pair_one() {
	local mac="$1" n=0
	valid_mac "$mac" || return 1
	mesh_member "$mac" && return 0
	mesh_rpc pair "{\"mac\":\"$mac\"}" || return 1
	# pair() only accepts the asynchronous request. Confirm the authenticated
	# topology before reporting success to the app, just as the LuCI view does.
	while [ "$n" -lt 23 ]; do
		mesh_member "$mac" && return 0
		sleep 2
		n=$((n + 1))
	done
	return 1
}

# Preserve the original agent's local command validation and binding protocol.
# Only authenticated cloud commands selected by run_command reach this bridge.
native_command() {
	local action="$1" command="$2" body result lanip data
	[ -x "$ORIG" ] && command -v timeout >/dev/null 2>&1 || return 1
	data=$(jsonfilter -s "$command" -e '@.payload' 2>/dev/null)
	[ -n "$data" ] || data=$(jsonfilter -s "$command" -e '@.params' 2>/dev/null)
	[ -n "$data" ] || data='{}'
	body="{\"kind\":\"$(jstr "$action")\",\"payload\":$data}"
	lanip=$(ubus -t 3 call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
	[ -n "$lanip" ] || return 1
	result=$(printf '%s' "$body" | REQUEST_METHOD=POST QUERY_STRING=op=command \
		REMOTE_ADDR="$lanip" HTTP_X_GWRT_TOKEN="$(cfg local_token)" \
		CONTENT_LENGTH="$(printf '%s' "$body" | wc -c)" timeout 45 "$ORIG" cgi) || return 1
	result=$(printf '%s\n' "$result" | tr -d '\r' | sed -n '/^{/,$p')
	[ "$(jsonfilter -s "$result" -e '@.ok' 2>/dev/null)" = true ] || return 1
	NATIVE_RESULT=$(jsonfilter -s "$result" -e '@.result' 2>/dev/null)
	return 0
}

# v1 命令执行: 默认关闭(只记日志+ack failed), uci 远程开关:
#   uci set gwrt-agent.main.remote_exec=1 && uci commit gwrt-agent
run_command() { # $1=json-command-object
	local j="$1" action
	# 云端 17.x 用 "kind"，老接口用 "action"，两个都认
	action=$(command_value "$j" action)
	[ -n "$action" ] || action=$(command_value "$j" kind)
	local cid mac nr en json st m result count failed
	cid=$(command_value "$j" command_id)
	[ -n "$cid" ] || cid=$(command_value "$j" id)
	[ -n "$action" ] || { log "pull: unparsable command: $j"; return; }
	log "pull: command action=$action id=$cid"
	case "$action" in
	agent.refresh) do_ack "$cid" success; return;;
	agent.issue_local_token|agent.rotate_local_token)
		if native_command "$action" "$j"; then do_ack "$cid" success "$NATIVE_RESULT";
		else do_ack "$cid" failed; fi
		return;;
	esac
	# mesh 控制默认开启（只操作 wifiroam）；危险命令仍要 remote_exec=1
	if [ "$(cfg mesh_control)" != "0" ]; then
		case "$action" in
		mesh.pair)
			mac=$(command_value "$j" mac)
			count=0; failed=0
			if [ -n "$mac" ]; then
				count=1
				mesh_pair_one "$mac" || failed=1
			else
				for m in $(ubus -t 3 call wifiroam discover 2>/dev/null | jsonfilter -e '@.devices[*].mac' 2>/dev/null); do
					count=$((count + 1))
					mesh_pair_one "$m" || failed=1
				done
			fi
			result=failed
			[ "$count" -gt 0 ] && [ "$failed" = 0 ] && result=success
			log "mesh: pair ${mac:-all} $result"
			do_ack "$cid" "$result"
			return ;;
		mesh.unpair)
			mac=$(command_value "$j" mac)
			result=failed
			if valid_mac "$mac" && mesh_rpc unpair "{\"mac\":\"$mac\"}"; then result=success; fi
			do_ack "$cid" "$result"
			return ;;
		mesh.role)
			nr=$(command_value "$j" role)
			case "$nr" in
			cap|unconfigured)
				result=failed
				mesh_rpc set_role "{\"role\":\"$nr\"}" && result=success
				log "mesh: role -> $nr $result"
				do_ack "$cid" "$result" ;;
			*) do_ack "$cid" failed ;;
			esac
			return ;;
		mesh.apmode)
			en=$(command_value "$j" enabled)
			case "$en" in 0|1) ;; *) do_ack "$cid" failed; return;; esac
			result=failed
			if [ "$en" = "0" ]; then
				/usr/libexec/gwrt-mesh-apmode off >/dev/null 2>&1 && result=success
			else
				uci -q set gwrt.mesh_apmode.enabled=1 && uci -q commit gwrt &&
					/etc/init.d/gwrt-mesh-apmode restart >/dev/null 2>&1 && result=success
			fi
			log "mesh: apmode=$en $result"
			do_ack "$cid" "$result"
			return ;;
		mesh.ssid_sync)
			st=$(ubus -t 3 call wifiroam status 2>/dev/null)
			result=failed
			case "$(jsonfilter -s "$st" -e '@.role' 2>/dev/null)" in
			cap)
				json=$(jsonfilter -s "$st" -e '@.roam' 2>/dev/null)
				[ -n "$json" ] && mesh_rpc set_roam "$json" && result=success ;;
			sap) /etc/init.d/wifiroam restart >/dev/null 2>&1 && result=success ;;
			esac
			log "mesh: ssid sync $result"
			do_ack "$cid" "$result"
			return ;;
		esac
	fi
	if [ "$(cfg remote_exec)" != "1" ]; then
		log "pull: remote_exec disabled, ignoring action=$action"
		do_ack "$cid" failed
		return
	fi
	case "$action" in
	system.reboot)
		do_ack "$cid" success
		sleep 2; reboot;;
	system.hostname.set)
		local hn
		hn=$(command_value "$j" hostname)
		if [ -n "$hn" ] && [ "${#hn}" -le 63 ] && printf '%s\n' "$hn" | grep -Eq '^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$' &&
			uci set system.@system[0].hostname="$hn" && uci commit system; then
			do_ack "$cid" success
		else do_ack "$cid" failed; fi;;
	wifi.*|network.*|plugin.*|client.*|oaf.*|package.*|istore.install|terminal.exec)
		if native_command "$action" "$j"; then do_ack "$cid" success "$NATIVE_RESULT";
		else do_ack "$cid" failed; fi;;
	*)
		do_ack "$cid" failed;;
	esac
}

handle_commands() {
	local rsp cmds requested
	GWRT_PULL_INTERVAL=""
	GWRT_PULL_OK=0
	# Rejected credentials deliver nothing (ack would 401 too): stay silent until
	# the backoff expires and the daemon re-registers.
	auth_blocked && return 0
	rsp=$(do_pull)
	requested=$(jsonfilter -s "$rsp" -e '@.report_interval' 2>/dev/null)
	if [ "$(jsonfilter -s "$rsp" -e '@.ok' 2>/dev/null)" = true ] && [ -n "$requested" ]; then
		GWRT_PULL_INTERVAL=$(interval_of "$rsp")
	fi
	cmds=$(jsonfilter -s "$rsp" -e '@.commands[*]' 2>/dev/null)
	if [ -n "$cmds" ]; then
		rm -f "$STATE_DIR/once-pull"
		GWRT_PULL_OK=1
		printf '%s\n' "$cmds" | while IFS= read -r c; do
			[ -n "$c" ] && run_command "$c"
		done
	else
		case "$(jsonfilter -s "$rsp" -e '@.commands' 2>/dev/null)" in
		'[ ]')
			rm -f "$STATE_DIR/once-pull"
			GWRT_PULL_OK=1
			;;
		*)
			# api() already logged the actionable 401/403 backoff line.
			auth_failure "$rsp" || log_once pull "pull FAILED: $rsp"
			;;
		esac
	fi
}

do_once() {
	local rsp iv
	rsp=$(do_report)
	iv=$(interval_of "$rsp")
	handle_commands
	echo "$iv"
}

# POST /api/agent/register: binds (device_id, pair_token) server-side.
# Same `Authorization: Bearer <pair_token>` header as every other call.
do_register() {
	local rsp
	if auth_blocked; then
		printf '%s' '__API_FAIL__ auth backoff'
		return 1
	fi
	rsp=$(api /api/agent/register "{\"device_id\":\"$(jstr "$(did)")\",\"agent_version\":1712,\"arch\":\"$(uname -m)\"}")
	if [ "$(jsonfilter -s "$rsp" -e '@.ok' 2>/dev/null)" = true ]; then
		rm -f "$STATE_DIR/once-register"
		printf '%s' "$rsp"
		return 0
	fi
	log_once register "register FAILED: $rsp"
	printf '%s' "$rsp"
	return 1
}

do_pair() {
	local rsp
	rsp=$(do_register) || { echo "注册失败: $rsp" >&2; return 1; }
	case "$(jsonfilter -s "$rsp" -e '@.ok' 2>/dev/null)" in
	true)
		echo "注册成功: $rsp"
		echo "设备码 device_id: $(did)"
		echo "配对码 pair_token: $(cfg pair_token)";;
	*) echo "注册失败: $rsp" >&2; return 1;;
	esac
}

do_status() {
	local left
	echo "gwrt-agent v1712-r9 (shim)"
	echo "device_id=$(did)"
	if [ -f "$AUTH_STATE" ]; then
		auth_read
		left=$((AUTH_UNTIL - $(date +%s)))
		echo "auth=rejected level=$AUTH_LEVEL retry_in=${left}s reason=$AUTH_REASON"
	else
		echo "auth=ok"
	fi
	echo "hardware_id=$(cfg hardware_id)"
	echo "endpoint=$(endpoint)"
	echo "endpoint_ipv6=$(ipv6_endpoint)"
	echo "transport=$(cat "$STATE_DIR/connection" 2>/dev/null)"
	echo "lan_ifname=$(cfg lan_ifname)"
	echo "firmware=$(. /etc/openwrt_release 2>/dev/null; echo "$DISTRIB_DESCRIPTION")"
}

# 2026-10-21 安全修复（一机一码）：固件内置的 device_id/pair_token/local_token 是共享的
# → 服务端只有一条设备记录，所有刷机设备合并成同一台。
# 启动时检查：为空/等于出厂共享值 -> 重新生成本机唯一身份，并自动重新注册。
GWRT_SHARED_DEVICE_ID="GWRT-9219ad6f5d11b7046aaa942d"
GWRT_SHARED_PAIR_TOKEN="99ec5d8f1c980bfe1ef131d6"
GWRT_SHARED_LOCAL_TOKEN="13258689ddbbe015f1ff35740cbcb1424851c76713b2d37e"
GWRT_SHARED_HARDWARE_ID="HW-b075f4d903f9d9835d136a5595118216"

rand_hex() {
	local n="$1" value="" part
	while [ "${#value}" -lt "$n" ]; do
		part=$(cat /proc/sys/kernel/random/uuid 2>/dev/null | tr -d -)
		[ -n "$part" ] || return 1
		value="$value$part"
	done
	printf '%s' "$value" | cut -c1-"$n"
}

ensure_device_id() {
	local cur base did changed=0 need_id=0 need_token=0

	cur=$(cfg device_id)
	case "$cur" in
	''|"$GWRT_SHARED_DEVICE_ID") need_id=1 ;;
	esac
	case "$(cfg pair_token)" in
	''|"$GWRT_SHARED_PAIR_TOKEN") need_token=1 ;;
	esac

	# 服务端在首次 register 时把 device_id 与 token 绑定：
	# 既要换 token，device_id 就必须也是全新的（否则落到旧记录 → 拒绝）。
	if [ "$need_id" = "1" ] || [ "$need_token" = "1" ]; then
		base=$(cfg hardware_id)
		case "$base" in
		''|"$GWRT_SHARED_HARDWARE_ID")
			base=$(cat /sys/class/net/br-lan/address 2>/dev/null)
			[ -n "$base" ] || base=$(cat /sys/class/net/eth0/address 2>/dev/null)
			;;
		esac
		if [ "$need_id" = "1" ]; then
			# 全新设备：按 hardware_id 派生（稳定、可复现）
			if [ -n "$base" ]; then
				did="GWRT-$(printf '%s' "$base" | sha256sum | cut -c1-24)"
			else
				did="GWRT-$(rand_hex 24)"
			fi
		else
			# 迁移设备（旧记录已存在）：全新随机 ID
			did="GWRT-$(rand_hex 24)"
		fi
		uci -q set gwrt-agent.main.device_id="$did"
		changed=1
	fi

	if [ "$need_token" = "1" ]; then
		uci -q set gwrt-agent.main.pair_token="$(rand_hex 24)"
		changed=1
	fi

	# local_token：共享值 -> 随机
	case "$(cfg local_token)" in
	''|"$GWRT_SHARED_LOCAL_TOKEN")
		uci -q set gwrt-agent.main.local_token="$(rand_hex 48)"
		changed=1
		;;
	esac

	[ "$changed" = "1" ] || return 0
	uci -q commit gwrt-agent
	log "身份一机一码化: device_id=$(cfg device_id)"
	# 2026-11-14：以前是 do_pair >/dev/null 2>&1，注册失败完全静默且不再重试，
	# 结果就是每次上报都 401 却永远不自愈。失败必须可见，并记入退避状态。
	if do_register >/dev/null; then
		log "云端注册成功: device_id=$(cfg device_id)"
	fi
	return 0
}

daemon() {
	log "daemon start (shim v1712-r9, endpoint=$(endpoint), ipv6=$(ipv6_endpoint))"
	ensure_device_id
	local iv next_report=0 started current delay rsp fails=0 ok wait
	iv=$(interval_of "")
	while :; do
		started=$(date +%s)
		ok=0
		if auth_blocked; then
			# Rejected credentials: the only useful request is one registration
			# attempt when the backoff expires.
			if auth_due && network_ready; then
				do_register >/dev/null
				auth_read
				# Still rejected (or unreachable): keep the backoff, do not hammer.
				[ -f "$AUTH_STATE" ] && auth_postpone "$(auth_delay)"
				next_report=0
			fi
		elif network_ready; then
			# Keep command polling responsive even when telemetry is idle.
			handle_commands
			[ "$GWRT_PULL_OK" = 1 ] && ok=1
			if [ -n "$GWRT_PULL_INTERVAL" ]; then
				[ "$GWRT_PULL_INTERVAL" -lt "$iv" ] && next_report=0
				iv="$GWRT_PULL_INTERVAL"
			fi
			current=$(date +%s)
			if [ "$current" -ge "$next_report" ]; then
				rsp=$(do_report)
				if [ "$(jsonfilter -s "$rsp" -e '@.ok' 2>/dev/null)" = true ]; then
					ok=1
					iv=$(interval_of "$rsp")
				fi
				next_report=$((current+iv))
			fi
		fi
		if [ "$ok" = 1 ]; then fails=0; else fails=$((fails+1)); fi
		delay=$((5-($(date +%s)-started)))
		[ "$delay" -gt 0 ] || delay=1
		# Repeated transport failures: slow down instead of retrying every 5s.
		[ "$fails" -ge 3 ] && [ "$delay" -lt 30 ] && delay=30
		if auth_blocked; then
			wait=$(auth_wait)
			[ "$wait" -gt "$delay" ] && delay="$wait"
		fi
		sleep "$delay"
	done
}

case "${1:-daemon}" in
	daemon|run) daemon;;
	register) do_pair;;
	once) do_once;;
	pair) shift; if [ -x "$ORIG" ]; then exec "$ORIG" pair "$@"; else echo 'gwrt-agent: this architecture has no gwrt-pair-v2 binary' >&2; exit 1; fi ;;
	dump) payload;;
	mesh) mesh_report;;
	cmd) shift; command_json="$1"; [ -n "$command_json" ] || command_json='{}'; run_command "$command_json";;
	status) do_status;;
	version|ver) echo "gwrt-agent 1712-r9";;
	cgi) [ -x "$ORIG" ] && exec "$ORIG" cgi || { echo "Status: 500"; echo; echo '{"ok":false,"error":"orig missing"}'; };;
	help|-h|--help)
		echo "用法: gwrt-agent [daemon|once|pair|register|dump|mesh|cmd|status|version|cgi|help]";;
	*) # 未知参数转发原二进制, 保证兼容
		[ -x "$ORIG" ] && exec "$ORIG" "$@" || { echo "gwrt-agent: unknown command '$1'" >&2; exit 1; };;
esac
