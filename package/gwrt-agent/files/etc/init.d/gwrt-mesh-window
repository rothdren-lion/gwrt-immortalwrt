#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	local mode="${GWRT_MESH_WINDOW_MODE:-boot}"

	/usr/sbin/gwrt-mesh-window prepare "$mode" >/dev/null 2>&1 || return 1

	procd_open_instance
	procd_set_param command /usr/sbin/gwrt-mesh-window watch
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

restart_pairing() {
	/etc/init.d/gwrt-mesh-window stop >/dev/null 2>&1 || true
	GWRT_MESH_WINDOW_MODE=restart /etc/init.d/gwrt-mesh-window start
}
