+
+int rtl822x_led_polarity_set(struct phy_device *phydev,
+			     struct rtl822x_led *led, int index,
+			     unsigned long modes)
+{
+	bool active_low = false;
+	u32 mode;
+
+	if (index >= RTL8211x_LED_COUNT)
+		return -EINVAL;
+
+	for_each_set_bit(mode, &modes, __PHY_LED_MODES_NUM) {
+		switch (mode) {
+		case PHY_LED_ACTIVE_LOW:
+			active_low = true;
+			break;
+		case PHY_LED_ACTIVE_HIGH:
+			break;
+		default:
+			return -EINVAL;
+		}
+	}
+
+	if (active_low)
+		led->active_low |= BIT(index);
+	else
+		led->active_low &= ~BIT(index);
+
+	return phy_modify_mmd(phydev, MDIO_MMD_VEND2, RTL822X_VND2_LCR7,
+			      RTL822X_VND2_LED_POLAR(index),
+			      active_low ? RTL822X_VND2_LED_POLAR(index) : 0);
 }
 
