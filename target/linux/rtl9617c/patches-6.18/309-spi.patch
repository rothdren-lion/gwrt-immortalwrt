diff --git a/drivers/spi/Kconfig b/drivers/spi/Kconfig
@@ -25,6 +25,13 @@
 
 if SPI
 
+config SPI_REALTEK_TAURUS_QSPI
+	tristate "Realtek Taurus QSPI controller"
+	depends on ARCH_REALTEK_TAURUS && OF
+	select SPI_MEM
+	help
+	  QSPI flash controller of the Realtek Taurus SoCs.
+
 config SPI_DEBUG
 	bool "Debug support for SPI drivers"
 	depends on DEBUG_KERNEL
diff --git a/drivers/spi/Makefile b/drivers/spi/Makefile
@@ -7,6 +7,7 @@
 
 # small core, mostly translating board-specific
 # config declarations into driver model code
+obj-$(CONFIG_SPI_REALTEK_TAURUS_QSPI)	+= spi-taurus-qspi.o
 obj-$(CONFIG_SPI_MASTER)		+= spi.o
 obj-$(CONFIG_SPI_MEM)			+= spi-mem.o
 obj-$(CONFIG_SPI_MUX)			+= spi-mux.o
