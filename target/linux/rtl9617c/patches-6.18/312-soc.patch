+	select SOC_BUS
+	help
+	  SoC identification support for the Realtek Taurus SoCs.
+
+config REALTEK_TAURUS_SPARE_REG
+	bool "Realtek Taurus spare register driver"
+	depends on SOC_REALTEK_TAURUS
+	help
+	  PER_SPARE register helper of the Realtek Taurus SoCs.
+
+config REALTEK_TAURUS_VSFC
+	bool "Realtek Taurus VSFC/UVLO monitor"
+	depends on SOC_REALTEK_TAURUS
+	help
+	  UVLO/VSFC state monitor of the Realtek Taurus SoCs.
