diff --git a/drivers/pinctrl/realtek/Kconfig b/drivers/pinctrl/realtek/Kconfig
@@ -4,6 +4,13 @@
 	tristate "Realtek DHC core pin controller driver"
 	depends on ARCH_REALTEK
 	default y
+
+config PINCTRL_REALTEK_TAURUS
+	bool "Realtek Taurus pin controller driver"
+	depends on ARCH_REALTEK_TAURUS && OF
+	select PINMUX
+	select PINCONF
+	select GENERIC_PINCONF
 	select PINMUX
 	select GENERIC_PINCONF
 	select REGMAP_MMIO
