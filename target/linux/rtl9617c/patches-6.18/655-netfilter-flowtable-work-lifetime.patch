From: Antigravity <dev@rtl9617c>
Subject: [PATCH] netfilter: serialize flowtable work admission and retirement

Do not queue new hardware offload work once hardware deletion has started,
and serialize retirement with pending asynchronous workers.

Claim NF_FLOW_PENDING before checking NF_FLOW_HW_DYING in
nf_flow_offload_work_alloc() so stale RCU readers (such as
flow_offload_refresh()) and closing-flow GC ticks cannot enqueue ADD or
STATS against a flow that is already being deleted from hardware.  Skip
already-dying flows on the fast paths as well.

Publish all worker updates (including NF_FLOW_HW_DEAD) with
clear_bit_unlock(NF_FLOW_PENDING) as the worker's final access to the
flow, paired with test_bit_acquire(NF_FLOW_PENDING) in
nf_flow_offload_gc_step().  Before unlinking and RCU-freeing a dead flow,
atomically claim NF_FLOW_PENDING and leave it set through retirement so
neither a late submitter nor a concurrent GC pass can race with
flow_offload_del().
---
--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -375,7 +375,8 @@ void flow_offload_refresh(struct nf_flow
 		return;
 
 	if (likely(!nf_flowtable_hw_offload(flow_table)) ||
-	    test_bit(NF_FLOW_CLOSING, &flow->flags))
+	    test_bit(NF_FLOW_CLOSING, &flow->flags) ||
+	    test_bit(NF_FLOW_HW_DYING, &flow->flags))
 		return;
 
 	nf_flow_offload_add(flow_table, flow);
@@ -608,7 +609,8 @@ static void nf_flow_offload_gc_step(stru
 {
 	bool teardown;
 
-	if (test_bit(NF_FLOW_PENDING, &flow->flags))
+	/* A queued worker owns the flow until it publishes its updates. */
+	if (test_bit_acquire(NF_FLOW_PENDING, &flow->flags))
 		return;
 
 	teardown = test_bit(NF_FLOW_TEARDOWN, &flow->flags);
@@ -628,16 +630,24 @@ static void nf_flow_offload_gc_step(stru
 		if (test_bit(NF_FLOW_HW, &flow->flags)) {
 			if (!test_bit(NF_FLOW_HW_DYING, &flow->flags))
 				nf_flow_offload_del(flow_table, flow);
-			else if (test_bit(NF_FLOW_HW_DEAD, &flow->flags))
+			else if (test_bit(NF_FLOW_HW_DEAD, &flow->flags) &&
+				 !test_and_set_bit(NF_FLOW_PENDING,
+						   &flow->flags)) {
+				/* Exclude late work, including pre-unlink RCU
+				 * readers.  Retirement keeps PENDING set
+				 * through the RCU free.
+				 */
 				flow_offload_del(flow_table, flow);
+			}
 		} else {
 			flow_offload_del(flow_table, flow);
 		}
 	} else if (test_bit(NF_FLOW_CLOSING, &flow->flags) &&
 		   test_bit(NF_FLOW_HW, &flow->flags) &&
 		   !test_bit(NF_FLOW_HW_DYING, &flow->flags)) {
 		nf_flow_offload_del(flow_table, flow);
-	} else if (test_bit(NF_FLOW_HW, &flow->flags)) {
+	} else if (test_bit(NF_FLOW_HW, &flow->flags) &&
+		   !test_bit(NF_FLOW_HW_DYING, &flow->flags)) {
 		nf_flow_offload_stats(flow_table, flow);
 	}
 }
--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -1198,8 +1198,11 @@ static void flow_offload_work_handler(st
 		default:
 			WARN_ON_ONCE(1);
 	}
-	smp_mb__before_atomic();
-	clear_bit(NF_FLOW_PENDING, &offload->flow->flags);
+	/* Publish worker updates (including NF_FLOW_HW_DEAD) before handing
+	 * ownership back to GC; this must be the worker's final access to
+	 * offload->flow.
+	 */
+	clear_bit_unlock(NF_FLOW_PENDING, &offload->flow->flags);
 
 	kfree(offload);
 }
@@ -1229,9 +1232,15 @@ nf_flow_offload_work_alloc(struct nf_flo
 	if (test_and_set_bit(NF_FLOW_PENDING, &flow->flags))
 		return NULL;
 
+	/* Recheck after acquiring ownership: hardware deletion is terminal. */
+	if (test_bit(NF_FLOW_HW_DYING, &flow->flags)) {
+		clear_bit_unlock(NF_FLOW_PENDING, &flow->flags);
+		return NULL;
+	}
+
 	offload = kmalloc(sizeof(struct flow_offload_work), GFP_ATOMIC);
 	if (!offload) {
-		clear_bit(NF_FLOW_PENDING, &flow->flags);
+		clear_bit_unlock(NF_FLOW_PENDING, &flow->flags);
 		return NULL;
 	}
 
