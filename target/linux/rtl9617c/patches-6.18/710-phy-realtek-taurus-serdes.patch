diff --git a/drivers/phy/realtek/Kconfig b/drivers/phy/realtek/Kconfig
@@ -29,4 +29,22 @@
 	  DWC3 USB IP. This driver will do the PHY initialization
 	  of the parameters.
 
+config PHY_REALTEK_TAURUS_SERDES
+	tristate "Realtek Taurus Ethernet SerDes PHY driver"
+	depends on ARCH_REALTEK_TAURUS || COMPILE_TEST
+	depends on OF && HAS_IOMEM
+	select GENERIC_PHY
+	help
+	  Ethernet SerDes of Realtek Taurus SoCs. It connects the network
+	  interface to an external PHY using SGMII or 2500BASE-X.
+
+config PHY_REALTEK_TAURUS_LANE
+	tristate "Realtek Taurus lane PHY driver"
+	depends on ARCH_REALTEK_TAURUS || COMPILE_TEST
+	depends on OF && HAS_IOMEM
+	select GENERIC_PHY
+	help
+	  Lane power control of the SerDes lanes of Realtek Taurus SoCs.
+	  Each lane serves PCIe, USB3 or SGMII/HSGMII controllers.
+
 endif # ARCH_REALTEK || COMPILE_TEST
diff --git a/drivers/phy/realtek/Makefile b/drivers/phy/realtek/Makefile
@@ -1,3 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
 obj-$(CONFIG_PHY_RTK_RTD_USB2PHY)	+= phy-rtk-usb2.o
 obj-$(CONFIG_PHY_RTK_RTD_USB3PHY)	+= phy-rtk-usb3.o
+obj-$(CONFIG_PHY_REALTEK_TAURUS_SERDES)	+= phy-taurus-serdes.o
+obj-$(CONFIG_PHY_REALTEK_TAURUS_LANE)	+= phy-taurus-lane.o
