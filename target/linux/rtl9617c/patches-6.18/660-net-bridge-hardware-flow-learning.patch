+			    u16 vid, bool source);
 bool br_port_flag_is_set(const struct net_device *dev, unsigned long flag);
 u8 br_port_get_stp_state(const struct net_device *dev);
 clock_t br_get_ageing_time(const struct net_device *br_dev);
diff --git a/net/bridge/br_fdb.c b/net/bridge/br_fdb.c
index fe85c8f19..aedf7e205 100644
--- a/net/bridge/br_fdb.c
+++ b/net/bridge/br_fdb.c
@@ -260,6 +260,27 @@ struct net_device *br_fdb_find_port(const struct net_device *br_dev,
 }
 EXPORT_SYMBOL_GPL(br_fdb_find_port);
 
+void br_fdb_refresh_offload(const struct net_device *dev, const unsigned char *addr,
+			    u16 vid, bool source)
+{
+	const struct net_bridge_port *port;
+	struct net_bridge_fdb_entry *fdb;
+
+	ASSERT_RTNL();
+	rcu_read_lock();
+	port = br_port_get_rcu(dev);
+	if (port) {
+		fdb = br_fdb_find_rcu(port->br, addr, vid);
+		if (fdb && READ_ONCE(fdb->dst) == port) {
+			WRITE_ONCE(fdb->used, jiffies);
+			if (source)
+				WRITE_ONCE(fdb->updated, jiffies);
+		}
+	}
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(br_fdb_refresh_offload);
+
 struct net_bridge_fdb_entry *br_fdb_find_rcu(struct net_bridge *br,
 					     const unsigned char *addr,
 					     __u16 vid)
