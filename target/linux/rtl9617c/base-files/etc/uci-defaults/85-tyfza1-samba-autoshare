#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Pre-enable samba autoshare so an inserted USB stick is discovered and shared
# automatically (autosamba's 20-smb hotplug). Keep user changes: only seed a
# value when the samba4 section is missing.
[ -f /etc/config/samba4 ] || exit 0

uci -q get samba4.@samba4[0] >/dev/null 2>&1 || {
	uci add samba4 samba4 >/dev/null
	uci set samba4.@samba4[-1].name='TYFZA1'
	uci set samba4.@samba4[-1].workgroup='WORKGROUP'
	uci set samba4.@samba4[-1].description='TYFZA1 USB Share'
	uci set samba4.@samba4[-1].autoshare='1'
}
# Ensure autoshare is on unless the user explicitly disabled it.
cur="$(uci -q get samba4.@samba4[0].autoshare)"
[ -z "$cur" ] && uci set samba4.@samba4[0].autoshare='1'
uci commit samba4
exit 0
