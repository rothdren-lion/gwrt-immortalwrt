#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# APK writes its primary architecture during rootfs assembly; add compatibility
# after that transaction, on first boot and after sysupgrade.
#
# The bundled offline wifiroam APKs are built for aarch64_cortex-a53.  This
# script must run BEFORE 96_gwrt-preset-apk installs them, otherwise apk only
# sees the a55 arch and rejects every preset package ("uninstallable"), which
# leaves Mesh/wifiroam completely uninstalled.  That is why the name is 90_*,
# not 98_*: uci-defaults execute in filename order and '-' sorts before '_'.
[ -s /etc/apk/keys/openwrt-snapshots.pem ] || exit 1
printf 'aarch64_cortex-a55\naarch64_cortex-a53\n' > /etc/apk/arch