#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# TYFZA1: USB mass storage plugged in -> automount puts it on /mnt/sda.
# Restart ksmbd shortly after so the pre-seeded /mnt/sda share becomes
# reachable without a manual reboot (replaces samba4 autosamba hotplug).
[ "$ACTION" = add ] || exit 0
[ -x /etc/init.d/ksmbd ] || exit 0
case "$DEVNAME" in
	/dev/sd*) ;;
	*) exit 0 ;;
esac
(
	sleep 5
	mount | grep -q " /mnt/sda " && /etc/init.d/ksmbd restart
) >/dev/null 2>&1 &
exit 0
