From: Robert Marko <robimarko@gmail.com>
Date: Mon, 16 Nov 2026 17:50:00 +0800
Subject: [PATCH] arm64: dts: qcom: ipq8074: add UNIPHY PCS nodes

The GCC clock controller takes the three UNIPHY RX/TX output pairs as
clock parents, so the labels have to exist in the SoC description. They
only lived in the ESS overlay, which the upstream reference boards
(ipq8074-hk01 and friends) never include, so those DTBs fail to compile:

  arch/arm64/boot/dts/qcom/ipq8074.dtsi:602.33-632.5:
  ERROR (phandle_references): /soc@0/clock-controller@1800000:
  Reference to non-existent node or label "uniphy0"

Describe the PCS blocks in the SoC DTSI instead, where every board sees
them, matching the reference topology: per-port RX/TX clock names equal
to the GCC clock-names, soft/xpcs resets, and clock-output-names
uniphyN_gcc_rx_clk / uniphyN_gcc_tx_clk so the GCC fw_name lookups
resolve. The nodes stay disabled; a board that brings up a port gates it.

Signed-off-by: Robert Marko <robimarko@gmail.com>
Signed-off-by: ViKing <viking.yfy@qq.com>
---
 arch/arm64/boot/dts/qcom/ipq8074.dtsi | 74 +++++++++++++++++++++++++++
 1 file changed, 71 insertions(+)

--- a/arch/arm64/boot/dts/qcom/ipq8074.dtsi
+++ b/arch/arm64/boot/dts/qcom/ipq8074.dtsi
@@ -393,6 +393,77 @@
 			assigned-clock-rates-u64 = /bits/ 64 <12000000000>;
 		};
 
+: efuse@a4000 {
+
+		uniphy0: ethernet-pcs@7a00000 {
+			compatible = "qualcomm,ipq8074-uniphy";
+			reg = <0x07a00000 0x10000>;
+			#pcs-cells = <1>;
+			clocks = <&gcc GCC_UNIPHY0_AHB_CLK>,
+				 <&gcc GCC_UNIPHY0_SYS_CLK>,
+				 <&gcc GCC_UNIPHY0_PORT1_RX_CLK>,
+				 <&gcc GCC_UNIPHY0_PORT1_TX_CLK>,
+				 <&gcc GCC_UNIPHY0_PORT2_RX_CLK>,
+				 <&gcc GCC_UNIPHY0_PORT2_TX_CLK>,
+				 <&gcc GCC_UNIPHY0_PORT3_RX_CLK>,
+				 <&gcc GCC_UNIPHY0_PORT3_TX_CLK>,
+				 <&gcc GCC_UNIPHY0_PORT4_RX_CLK>,
+				 <&gcc GCC_UNIPHY0_PORT4_TX_CLK>,
+				 <&gcc GCC_UNIPHY0_PORT5_RX_CLK>,
+				 <&gcc GCC_UNIPHY0_PORT5_TX_CLK>;
+			clock-names = "ahb", "sys",
+				      "port1_rx", "port1_tx",
+				      "port2_rx", "port2_tx",
+				      "port3_rx", "port3_tx",
+				      "port4_rx", "port4_tx",
+				      "port5_rx", "port5_tx";
+			clock-output-names = "uniphy0_gcc_rx_clk",
+					     "uniphy0_gcc_tx_clk";
+			#clock-cells = <1>;
+			resets = <&gcc GCC_UNIPHY0_SOFT_RESET>,
+				 <&gcc GCC_UNIPHY0_XPCS_RESET>;
+			reset-names = "soft", "xpcs";
+			status = "disabled";
+		};
+
+		uniphy1: ethernet-pcs@7a10000 {
+			compatible = "qualcomm,ipq8074-uniphy";
+			reg = <0x07a10000 0x10000>;
+			#pcs-cells = <1>;
+			clocks = <&gcc GCC_UNIPHY1_AHB_CLK>,
+				 <&gcc GCC_UNIPHY1_SYS_CLK>,
+				 <&gcc GCC_UNIPHY1_PORT5_RX_CLK>,
+				 <&gcc GCC_UNIPHY1_PORT5_TX_CLK>;
+			clock-names = "ahb", "sys",
+				      "port5_rx", "port5_tx";
+			clock-output-names = "uniphy1_gcc_rx_clk",
+					     "uniphy1_gcc_tx_clk";
+			#clock-cells = <1>;
+			resets = <&gcc GCC_UNIPHY1_SOFT_RESET>,
+				 <&gcc GCC_UNIPHY1_XPCS_RESET>;
+			reset-names = "soft", "xpcs";
+			status = "disabled";
+		};
+
+		uniphy2: ethernet-pcs@7a20000 {
+			compatible = "qualcomm,ipq8074-uniphy";
+			reg = <0x07a20000 0x10000>;
+			#pcs-cells = <1>;
+			clocks = <&gcc GCC_UNIPHY2_AHB_CLK>,
+				 <&gcc GCC_UNIPHY2_SYS_CLK>,
+				 <&gcc GCC_UNIPHY2_PORT6_RX_CLK>,
+				 <&gcc GCC_UNIPHY2_PORT6_TX_CLK>;
+			clock-names = "ahb", "sys",
+				      "port6_rx", "port6_tx";
+			clock-output-names = "uniphy2_gcc_rx_clk",
+					     "uniphy2_gcc_tx_clk";
+			#clock-cells = <1>;
+			resets = <&gcc GCC_UNIPHY2_SOFT_RESET>,
+				 <&gcc GCC_UNIPHY2_XPCS_RESET>;
+			reset-names = "soft", "xpcs";
+			status = "disabled";
+		};
+
 		qfprom: efuse@a4000 {
 			compatible = "qcom,ipq8074-qfprom", "qcom,qfprom";
 			reg = <0x000a4000 0x2000>;
