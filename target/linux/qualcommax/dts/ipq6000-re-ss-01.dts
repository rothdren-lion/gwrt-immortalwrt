			};

			cooling-maps {

				map0 {
					trip = <0x26>;
					cooling-device = <0x27 0xffffffff 0xffffffff 0x28 0xffffffff 0xffffffff 0x29 0xffffffff 0xffffffff 0x2a 0xffffffff 0xffffffff>;
				};
			};
		};

		lpass-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x25 0x0e>;

			trips {

				lpass-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		ddrss-top-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x25 0x0f>;

			trips {

				ddrss-top-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
