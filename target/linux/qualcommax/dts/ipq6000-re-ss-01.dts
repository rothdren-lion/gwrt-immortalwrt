/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	model = "JDCloud RE-SS-01";
	compatible = "jdcloud,re-ss-01", "qcom,ipq6018";

	clocks {

		sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <0x7d00>;
			#clock-cells = <0x00>;
			phandle = <0x0e>;
		};

		xo {
			compatible = "fixed-clock";
			clock-frequency = <0x16e3600>;
			#clock-cells = <0x00>;
			phandle = <0x0a>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			clocks = <0x03 0x01>;
			clock-names = "cpu";
			operating-points-v2 = <0x04>;
			#cooling-cells = <0x02>;
			phandle = <0x27>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			enable-method = "psci";
			reg = <0x01>;
			next-level-cache = <0x02>;
			clocks = <0x03 0x01>;
			clock-names = "cpu";
			operating-points-v2 = <0x04>;
			#cooling-cells = <0x02>;
			phandle = <0x28>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			enable-method = "psci";
			reg = <0x02>;
			next-level-cache = <0x02>;
			clocks = <0x03 0x01>;
			clock-names = "cpu";
			operating-points-v2 = <0x04>;
			#cooling-cells = <0x02>;
			phandle = <0x29>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			enable-method = "psci";
			reg = <0x03>;
			next-level-cache = <0x02>;
			clocks = <0x03 0x01>;
			clock-names = "cpu";
			operating-points-v2 = <0x04>;
			#cooling-cells = <0x02>;
			phandle = <0x2a>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			phandle = <0x02>;
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-ipq6018", "qcom,scm";
			qcom,dload-mode = <0x05 0x6100>;
		};
	};

	opp-table-cpu {
		compatible = "operating-points-v2-kryo-cpu";
		nvmem-cells = <0x06>;
		opp-shared;
		phandle = <0x04>;

		opp-864000000 {
			opp-hz = <0x00 0x337f9800>;
			opp-microvolt = <0xb1008>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1056000000 {
			opp-hz = <0x00 0x3ef14800>;
			opp-microvolt = <0xc042c>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1200000000 {
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt = <0xcf850>;
			opp-supported-hw = <0x04>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1320000000 {
			opp-hz = <0x00 0x4ead9a00>;
			opp-microvolt = <0xd2924>;
			opp-supported-hw = <0x03>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1440000000 {
			opp-hz = <0x00 0x55d4a800>;
			opp-microvolt = <0xe1d48>;
			opp-supported-hw = <0x03>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1512000000 {
			opp-hz = <0x00 0x5a1f4a00>;
			opp-microvolt = <0xe4e1c>;
			opp-supported-hw = <0x02>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1608000000 {
			opp-hz = <0x00 0x5fd82200>;
			opp-microvolt = <0xf116c>;
			opp-supported-hw = <0x01>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1800000000 {
			opp-hz = <0x00 0x6b49d200>;
			opp-microvolt = <0x103664>;
			opp-supported-hw = <0x01>;
			clock-latency-ns = <0x30d40>;
		};
	};

	pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <0x01 0x07 0xf04>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	remoteproc {
		compatible = "qcom,ipq6018-rpm-proc", "qcom,rpm-proc";
		status = "disabled";

		glink-edge {
			compatible = "qcom,glink-rpm";
			interrupts = <0x00 0xa8 0x01>;
			qcom,rpm-msg-ram = <0x07>;
			mboxes = <0x03 0x00>;

			rpm-requests {
				compatible = "qcom,rpm-ipq6018", "qcom,glink-smd-rpm";
				qcom,glink-channels = "rpm_requests";
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		memory@60000 {
			reg = <0x00 0x60000 0x00 0x6000>;
			no-map;
			phandle = <0x07>;
		};

		memory@40000000 {
			reg = <0x00 0x40000000 0x00 0x1000000>;
			no-map;
		};

		bootloader@4a100000 {
			reg = <0x00 0x4a100000 0x00 0x400000>;
			no-map;
		};

		sbl@4a500000 {
			reg = <0x00 0x4a500000 0x00 0x100000>;
			no-map;
		};

		memory@4a600000 {
			reg = <0x00 0x4a600000 0x00 0x400000>;
			no-map;
		};

		memory@4aa00000 {
			compatible = "qcom,smem";
			reg = <0x00 0x4aa00000 0x00 0x100000>;
			no-map;
			hwlocks = <0x08 0x03>;
		};

		memory@4ab00000 {
			reg = <0x00 0x4ab00000 0x00 0x3700000>;
			no-map;
			phandle = <0x1c>;
		};
	};

	soc@0 {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges = <0x00 0x00 0x00 0x00 0x00 0xffffffff>;
		dma-ranges;
		compatible = "simple-bus";

		qusb@59000 {
			compatible = "qcom,ipq6018-qusb2-phy";
			reg = <0x00 0x59000 0x00 0x180>;
			#phy-cells = <0x00>;
			clocks = <0x09 0xa5 0x0a>;
			clock-names = "cfg_ahb", "ref";
			resets = <0x09 0x2c>;
			status = "disabled";
			phandle = <0x11>;
		};

		ssphy@78000 {
			compatible = "qcom,ipq6018-qmp-usb3-phy";
			reg = <0x00 0x78000 0x00 0x1000>;
			clocks = <0x09 0x9d 0x0a 0x09 0xa0 0x09 0xa1>;
			clock-names = "aux", "ref", "cfg_ahb", "pipe";
			clock-output-names = "gcc_usb0_pipe_clk_src";
			#clock-cells = <0x00>;
			#phy-cells = <0x00>;
			resets = <0x09 0x27 0x09 0x28>;
			reset-names = "phy", "phy_phy";
			status = "okay";
			phandle = <0x17>;
		};

		qusb@79000 {
			compatible = "qcom,ipq6018-qusb2-phy";
			reg = <0x00 0x79000 0x00 0x180>;
			#phy-cells = <0x00>;
			clocks = <0x09 0xa0 0x0a>;
			clock-names = "cfg_ahb", "ref";
			resets = <0x09 0x2b>;
			status = "okay";
			phandle = <0x16>;
		};

		phy@84000 {
			compatible = "qcom,ipq6018-qmp-pcie-phy";
			reg = <0x00 0x84000 0x00 0x1000>;
			status = "disabled";
			clocks = <0x09 0x84 0x09 0x83 0x09 0x87>;
			clock-names = "aux", "cfg_ahb", "pipe";
			clock-output-names = "gcc_pcie0_pipe_clk_src";
			#clock-cells = <0x00>;
			#phy-cells = <0x00>;
			resets = <0x09 0x45 0x09 0x46>;
			reset-names = "phy", "common";
			phandle = <0x1d>;
		};

		mdio@90000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "qcom,ipq6018-mdio", "qcom,ipq4019-mdio";
			reg = <0x00 0x90000 0x00 0x64>;
			clocks = <0x09 0x5b>;
			clock-names = "gcc_mdio_ahb_clk";
			status = "okay";
			pinctrl-0 = <0x0b>;
			pinctrl-names = "default";
			reset-gpios = <0x0c 0x4b 0x01>;

			ethernet-phy-package@0 {
				compatible = "qcom,qca8075-package";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x00>;

				ethernet-phy@1 {
					compatible = "ethernet-phy-ieee802.3-c22";
					reg = <0x01>;
					phandle = <0x21>;
				};

				ethernet-phy@2 {
					compatible = "ethernet-phy-ieee802.3-c22";
					reg = <0x02>;
					phandle = <0x22>;
				};

				ethernet-phy@3 {
					compatible = "ethernet-phy-ieee802.3-c22";
					reg = <0x03>;
					phandle = <0x23>;
				};

				ethernet-phy@4 {
					compatible = "ethernet-phy-ieee802.3-c22";
					reg = <0x04>;
					phandle = <0x24>;
				};
			};
		};

		efuse@a4000 {
			compatible = "qcom,ipq6018-qfprom", "qcom,qfprom";
			reg = <0x00 0xa4000 0x00 0x2000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			cpu-speed-bin@135 {
				reg = <0x135 0x01>;
				bits = <0x07 0x01>;
				phandle = <0x06>;
			};
		};

		qrng@e3000 {
			compatible = "qcom,prng-ee";
			reg = <0x00 0xe3000 0x00 0x1000>;
			clocks = <0x09 0x88>;
			clock-names = "core";
		};

		thermal-sensor@4a9000 {
			compatible = "qcom,ipq6018-tsens", "qcom,ipq8074-tsens";
			reg = <0x00 0x4a9000 0x00 0x1000 0x00 0x4a8000 0x00 0x1000>;
			interrupts = <0x00 0xb8 0x04>;
			interrupt-names = "combined";
			#qcom,sensors = <0x10>;
			#thermal-sensor-cells = <0x01>;
			phandle = <0x25>;
		};

		dma-controller@704000 {
			compatible = "qcom,bam-v1.7.0";
			reg = <0x00 0x704000 0x00 0x20000>;
			interrupts = <0x00 0xcf 0x04>;
			clocks = <0x09 0x56>;
			clock-names = "bam_clk";
			#dma-cells = <0x01>;
			qcom,ee = <0x01>;
			qcom,controlled-remotely;
			phandle = <0x0d>;
		};

		crypto@73a000 {
			compatible = "qcom,crypto-v5.1";
			reg = <0x00 0x73a000 0x00 0x6000>;
			clocks = <0x09 0x56 0x09 0x57 0x09 0x58>;
			clock-names = "iface", "bus", "core";
			dmas = <0x0d 0x02 0x0d 0x03>;
			dma-names = "rx", "tx";
		};

		pinctrl@1000000 {
			compatible = "qcom,ipq6018-pinctrl";
			reg = <0x00 0x1000000 0x00 0x300000>;
			interrupts = <0x00 0xd0 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x0c 0x00 0x00 0x50>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			gpio-reserved-ranges = <0x14 0x01>;
			phandle = <0x0c>;

			serial3-state {
				pins = "gpio44", "gpio45";
				function = "blsp2_uart";
				drive-strength = <0x08>;
				bias-pull-down;
				phandle = <0x12>;
			};

			qpic-state {
				pins = "gpio1", "gpio3", "gpio4", "gpio5", "gpio6", "gpio7", "gpio8", "gpio10", "gpio11", "gpio12", "gpio13", "gpio14", "gpio15", "gpio17";
				function = "qpic_pad";
				drive-strength = <0x08>;
				bias-disable;
				phandle = <0x15>;
			};

			button-pins {
				phandle = <0x2b>;

				mux {
					pins = "gpio8", "gpio9";
					function = "gpio";
					drive-strength = <0x08>;
					bias-pull-up;
				};
			};

			mdio-pins {
				phandle = <0x0b>;

				mdc {
					pins = "gpio64";
					function = "mdc";
					drive-strength = <0x08>;
					bias-pull-up;
				};

				mdio {
					pins = "gpio65";
					function = "mdio";
					drive-strength = <0x08>;
					bias-pull-up;
				};
			};
		};

		clock-controller@1800000 {
			compatible = "qcom,gcc-ipq6018";
			reg = <0x00 0x1800000 0x00 0x80000>;
			clocks = <0x0a 0x0e 0x0f 0x00 0x0f 0x01 0x10 0x00 0x10 0x01>;
			clock-names = "xo", "sleep_clk", "uniphy0_gcc_rx_clk", "uniphy0_gcc_tx_clk", "uniphy1_gcc_rx_clk", "uniphy1_gcc_tx_clk";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x09>;
		};

		hwlock@1905000 {
			compatible = "qcom,ipq6018-tcsr-mutex", "qcom,tcsr-mutex";
			reg = <0x00 0x1905000 0x00 0x20000>;
			#hwlock-cells = <0x01>;
			phandle = <0x08>;
		};

		syscon@1937000 {
			compatible = "qcom,tcsr-ipq6018", "syscon";
			reg = <0x00 0x1937000 0x00 0x21000>;
			phandle = <0x05>;
		};

		pwm@1941010 {
			compatible = "qcom,ipq6018-pwm";
			reg = <0x00 0x1941010 0x00 0x20>;
			clocks = <0x09 0xc1>;
			assigned-clocks = <0x09 0xc1>;
			assigned-clock-rates = <0x5f5e100>;
			#pwm-cells = <0x03>;
			status = "disabled";
		};

		usb@7000000 {
			compatible = "qcom,ipq6018-dwc3", "qcom,snps-dwc3";
			reg = <0x00 0x7000000 0x00 0xfc100>;
			clocks = <0x09 0xa3 0x09 0xa6 0x09 0xa4>;
			clock-names = "core", "sleep", "mock_utmi";
			assigned-clocks = <0x09 0xa3 0x09 0xa4>;
			assigned-clock-rates = <0x7f27450 0x16e3600>;
			interrupts = <0x00 0x63 0x04 0x00 0x80 0x04 0x00 0x82 0x04>;
			interrupt-names = "dwc_usb3", "pwr_event", "qusb2_phy";
			resets = <0x09 0x2a>;
			phys = <0x11>;
			phy-names = "usb2-phy";
			tx-fifo-resize;
			snps,is-utmi-l1-suspend;
			snps,hird-threshold = [00];
			snps,dis_u2_susphy_quirk;
			snps,dis_u3_susphy_quirk;
			status = "disabled";
		};

		mmc@7804000 {
			compatible = "qcom,ipq6018-sdhci", "qcom,sdhci-msm-v5";
			reg = <0x00 0x7804000 0x00 0x1000 0x00 0x7805000 0x00 0x1000>;
			reg-names = "hc", "cqhci";
			interrupts = <0x00 0x7b 0x04 0x00 0x8a 0x04>;
			interrupt-names = "hc_irq", "pwr_irq";
			clocks = <0x09 0x8b 0x09 0x8c 0x0a>;
			clock-names = "iface", "core", "xo";
			resets = <0x09 0x2d>;
			max-frequency = <0xb71b000>;
			status = "okay";
			bus-width = <0x08>;
			mmc-ddr-1_8v;
			mmc-hs200-1_8v;
			non-removable;
		};

		dma-controller@7884000 {
			compatible = "qcom,bam-v1.7.0";
			reg = <0x00 0x7884000 0x00 0x2b000>;
			interrupts = <0x00 0xee 0x04>;
			clocks = <0x09 0x43>;
			clock-names = "bam_clk";
			#dma-cells = <0x01>;
			qcom,ee = <0x00>;
			phandle = <0x13>;
		};

		serial@78af000 {
			compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
			reg = <0x00 0x78af000 0x00 0x200>;
			interrupts = <0x00 0x6b 0x04>;
			clocks = <0x09 0x50 0x09 0x43>;
			clock-names = "core", "iface";
			status = "disabled";
		};

		serial@78b0000 {
			compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
			reg = <0x00 0x78b0000 0x00 0x200>;
			interrupts = <0x00 0x6c 0x04>;
			clocks = <0x09 0x51 0x09 0x43>;
			clock-names = "core", "iface";
			status = "disabled";
		};

		serial@78b1000 {
			compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
			reg = <0x00 0x78b1000 0x00 0x200>;
			interrupts = <0x00 0x132 0x04>;
			clocks = <0x09 0x52 0x09 0x43>;
			clock-names = "core", "iface";
			status = "okay";
			pinctrl-0 = <0x12>;
			pinctrl-names = "default";
		};

		serial@78b2000 {
			compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
			reg = <0x00 0x78b2000 0x00 0x200>;
			interrupts = <0x00 0x133 0x04>;
			clocks = <0x09 0x53 0x09 0x43>;
			clock-names = "core", "iface";
			status = "disabled";
		};

		serial@78b3000 {
			compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
			reg = <0x00 0x78b3000 0x00 0x200>;
			interrupts = <0x00 0x134 0x04>;
			clocks = <0x09 0x54 0x09 0x43>;
			clock-names = "core", "iface";
			status = "disabled";
		};

		serial@78b4000 {
			compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
			reg = <0x00 0x78b4000 0x00 0x200>;
			interrupts = <0x00 0x135 0x04>;
			clocks = <0x09 0x55 0x09 0x43>;
			clock-names = "core", "iface";
			status = "disabled";
		};

		spi@78b5000 {
			compatible = "qcom,spi-qup-v2.2.1";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x78b5000 0x00 0x600>;
			interrupts = <0x00 0x5f 0x04>;
			clocks = <0x09 0x45 0x09 0x43>;
			clock-names = "core", "iface";
			dmas = <0x13 0x0c 0x13 0x0d>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		spi@78b6000 {
			compatible = "qcom,spi-qup-v2.2.1";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x78b6000 0x00 0x600>;
			interrupts = <0x00 0x60 0x04>;
			clocks = <0x09 0x47 0x09 0x43>;
			clock-names = "core", "iface";
			dmas = <0x13 0x0e 0x13 0x0f>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		spi@78b9000 {
			compatible = "qcom,spi-qup-v2.2.1";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x78b9000 0x00 0x600>;
			interrupts = <0x00 0x12b 0x04>;
			clocks = <0x09 0x4d 0x09 0x43>;
			clock-names = "core", "iface";
			dmas = <0x13 0x14 0x13 0x15>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		i2c@78b6000 {
			compatible = "qcom,i2c-qup-v2.2.1";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x78b6000 0x00 0x600>;
			interrupts = <0x00 0x60 0x04>;
			clocks = <0x09 0x46 0x09 0x43>;
			clock-names = "core", "iface";
			clock-frequency = <0x61a80>;
			dmas = <0x13 0x0e 0x13 0x0f>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		i2c@78b7000 {
			compatible = "qcom,i2c-qup-v2.2.1";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x78b7000 0x00 0x600>;
			interrupts = <0x00 0x61 0x04>;
			clocks = <0x09 0x48 0x09 0x43>;
			clock-names = "core", "iface";
			clock-frequency = <0x61a80>;
			dmas = <0x13 0x10 0x13 0x11>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		i2c@78ba000 {
			compatible = "qcom,i2c-qup-v2.2.1";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
