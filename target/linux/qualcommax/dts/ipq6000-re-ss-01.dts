	wcss-smp2p {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1b3 0x1ac>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x142 0x01>;
		mboxes = <0x03 0x09>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			qcom,smp2p-feature-ssr-ack;
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x1b>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x1a>;
		};
	};

	aliases {
		ethernet1 = "/soc@0/ppe@3a000000/ports/port@2";
		ethernet2 = "/soc@0/ppe@3a000000/ports/port@3";
		ethernet3 = "/soc@0/ppe@3a000000/ports/port@4";
		ethernet4 = "/soc@0/ppe@3a000000/ports/port@5";
		serial0 = "/soc@0/serial@78b1000";
		label-mac-device = "/soc@0/ppe@3a000000/ports/port@2";
		led-boot = "/leds/red";
		led-failsafe = "/leds/red";
		led-running = "/leds/green";
		led-upgrade = "/leds/blue";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x2b>;
		pinctrl-names = "default";

		wps {
			label = "wps";
			linux,code = <0x211>;
			gpios = <0x0c 0x08 0x01>;
		};

		reset {
			label = "reset";
			linux,code = <0x198>;
			gpios = <0x0c 0x09 0x01>;
		};
	};

	leds {
		compatible = "gpio-leds";

		red {
			color = <0x01>;
			function = "status";
			gpios = <0x0c 0x25 0x00>;
		};

		blue {
			color = <0x03>;
			function = "status";
			gpios = <0x0c 0x23 0x00>;
		};

		green {
			color = <0x02>;
			function = "status";
			gpios = <0x0c 0x32 0x00>;
		};
	};
};
