	thermal-zones {

		nss-top-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x25 0x04>;

			trips {

				nss-top-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		nss-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x25 0x05>;

			trips {

				nss-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		wcss-phya0-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x25 0x07>;

			trips {

				wcss-phya0-critical {
