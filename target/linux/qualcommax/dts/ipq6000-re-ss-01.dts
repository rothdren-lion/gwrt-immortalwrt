			trips {

				wcss-phya1-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		cpu-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x25 0x0d>;

			trips {

				cpu-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};

				cpu-passive {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x26>;
