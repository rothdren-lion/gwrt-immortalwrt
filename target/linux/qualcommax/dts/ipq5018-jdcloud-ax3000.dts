/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "JDCloud AX3000 (RE-CS-03)";
	compatible = "jdcloud,ax3000", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;
		led-boot = &led_green;
		led-failsafe = &led_red;
		led-running = &led_green;
		led-upgrade = &led_blue;
		label-mac-device = &gmac1;
	};

	chosen {
		/* eMMC (GPT): root= supplied by APPSBL, like stock/Nwrt */
		bootargs-append = " swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps-button {
			label = "wps";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		/* Polarity from Nwrt DTB flags (0x00 = active high), best guess */
		led_blue: led-0 {
			label = "blue:status";
			gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_green: led-1 {
			label = "green:status";
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_red: led-2 {
			label = "red:status";
			gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&sdhc_1 {
	status = "okay";
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
};

// MAC0 -> internal GE PHY -> WAN (no external switch involved)
&gmac0 {
	status = "okay";

	phy-handle = <&ge_phy>;
	phy-mode = "gmii";
	label = "wan";
};

// MAC1 -> SGMII -> QCA8337 CPU port
&gmac1 {
	status = "okay";

	phy-mode = "sgmii";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

// MAC0 -> GE Phy (internal)
&ge_phy {
	qcom,dac-preset-short-cable;
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;

	// QCA8337 Phy0 -> LAN1
	qca8337_0: ethernet-phy@0 {
		reg = <0>;
	};

	// QCA8337 Phy1 -> LAN2
	qca8337_1: ethernet-phy@1 {
		reg = <1>;
	};

	// QCA8337 Phy2 -> LAN3
	qca8337_2: ethernet-phy@2 {
		reg = <2>;
	};

	// QCA8337 Phy3 -> LAN4
	qca8337_3: ethernet-phy@3 {
		reg = <3>;
	};

	// QCA8337 switch
	switch1: ethernet-switch@17 {
		compatible = "qca,qca8337";
		reg = <17>;
		#address-cells = <1>;
		#size-cells = <0>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@0 {
				reg = <0>;
				phy-mode = "sgmii";
				ethernet = <&gmac1>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			ethernet-port@1 {
				reg = <1>;
				label = "lan1";
				phy-handle = <&qca8337_0>;
			};

			ethernet-port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&qca8337_1>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "lan3";
				phy-handle = <&qca8337_2>;
			};

			ethernet-port@4 {
				reg = <4>;
				label = "lan4";
				phy-handle = <&qca8337_3>;
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		button-pins {
			pins = "gpio25", "gpio38";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};

	};

	led_pins: led-state {
		pins = "gpio31", "gpio32", "gpio33";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	switch_reset_pins: switch-reset-state {
		pins = "gpio39";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	serial_0_pins: uart0-state {
		pins = "gpio28", "gpio29";
		function = "blsp0_uart1";
		drive-strength = <8>;
		bias-disable;
	};
};

/*
 * GWRT mesh AP: Wi-Fi radios enabled from day one (same IPQ5018+QCN6122
 * as PZ-L8). Board data comes from package/firmware/jdcloud-ax3000-wifi-board
 * (stock BDFs extracted from Nwrt factory image as board.bin fallback);
 * calibration/MAC from eMMC 0:ART via 11-ath11k-caldata (jdcloud,ax3000).
 * If the box OOMs, revisit fw-memory-mode / BDF.
 */
&q6v5_wcss {
	status = "okay";
};

&wifi {
	// IPQ5018
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-calibration-variant = "JDCloud-AX3000";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;

	ieee80211-freq-limit = <2400000 2483000>;

	status = "okay";
};

&wifi1 {
	// QCN6102 5G
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "JDCloud-AX3000";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;

	ieee80211-freq-limit = <5150000 5730000>;

	status = "okay";
};
