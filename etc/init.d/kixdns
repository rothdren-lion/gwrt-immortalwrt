#!/bin/sh /etc/rc.common
# Copyright (C) 2026 GWRT

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/kixdns

start_service() {
	local enabled config_file debug

	config_load kixdns
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get config_file main config_file /etc/kixdns/pipeline.json
	config_get_bool debug main debug 0

	if [ ! -f "$config_file" ]; then
		logger -t kixdns "config $config_file missing, not starting"
		return 1
	fi

	procd_open_instance kixdns
	procd_set_param command "$PROG" run -c "$config_file"
	[ "$debug" -eq 1 ] && procd_append_param command --debug
	# /etc/kixdns/pipeline.json 由 kixdns 自己的 file watcher 热加载，
	# 这里不再用 procd_set_param file，避免配置改动触发整进程重启。
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger kixdns
}
